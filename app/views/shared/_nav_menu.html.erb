<%# locals: label (String), items (Array of { label:, path: }), align: (:start | :end, optional) %>
<% panel_class = (local_assigns[:align] == :end) ? "nav-menu-panel nav-menu-panel--end" : "nav-menu-panel" %>
<% panel_side = (local_assigns[:align] == :end) ? "right:0;left:auto;" : "" %>
<div class="nav-menu" style="position:relative;flex-shrink:0" data-nav-menus-target="wrapper">
  <button type="button"
          class="nav-menu-trigger"
          data-nav-menus-target="button"
          data-action="click->nav-menus#toggle"
          aria-haspopup="true"
          aria-expanded="false">
    <%= label %>
    <svg class="nav-menu-chevron" width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </button>
  <div class="<%= panel_class %>"
       data-nav-menus-target="panel"
       role="menu"
       hidden>
    <% items.each do |item| %>
      <%= link_to item[:label], item[:path], class: "nav-menu-item", role: "menuitem" %>
    <% end %>
  </div>
</div>
