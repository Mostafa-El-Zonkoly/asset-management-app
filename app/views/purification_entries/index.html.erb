<% content_for :title, "Purification (تطهير)" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900">Purification (تطهير)</h1>
    <p class="mt-1 max-w-2xl text-sm text-slate-600">
      The list to purify, segmented from your FIFO lots. The app produces each line
      (period, quantity held, day-weight); you enter the amount to purify and mark
      it done. <span class="font-medium">share-days</span> = Σ quantity × days held,
      the basis for splitting an amount across periods.
    </p>
  </div>
  <%= button_to "Refresh all", generate_purification_entries_path(status: @selected_status),
        method: :post,
        class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
</div>

<!-- Filters -->
<%= form_with url: purification_entries_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do %>
  <div>
    <label class="block text-xs font-medium uppercase text-slate-500">Portfolio</label>
    <%= select_tag :portfolio_id,
          options_for_select([["All portfolios", ""]] + @portfolios.map { |p| [p.name, p.id] }, @selected_portfolio_id),
          class: "mt-1 rounded-md border border-slate-300 px-3 py-1.5 text-sm" %>
  </div>
  <div>
    <label class="block text-xs font-medium uppercase text-slate-500">Status</label>
    <%= select_tag :status,
          options_for_select([["All statuses", ""]] + PurificationEntry::STATUSES.map { |s| [s.humanize, s] }, @selected_status),
          class: "mt-1 rounded-md border border-slate-300 px-3 py-1.5 text-sm" %>
  </div>
  <%= submit_tag "Apply", class: "rounded-md bg-slate-100 px-4 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-200" %>
  <% if @selected_portfolio_id || @selected_status %>
    <%= link_to "Clear", purification_entries_path, class: "px-2 py-1.5 text-sm text-blue-600 hover:underline" %>
  <% end %>
<% end %>

<!-- Summary -->
<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="text-xs uppercase text-slate-500">Pending</div>
    <div class="mt-1 text-2xl font-semibold text-amber-600 tabular-nums"><%= @summary[:pending] %></div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="text-xs uppercase text-slate-500">Done</div>
    <div class="mt-1 text-2xl font-semibold text-emerald-600 tabular-nums"><%= @summary[:done] %></div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="text-xs uppercase text-slate-500">Not required</div>
    <div class="mt-1 text-2xl font-semibold text-slate-500 tabular-nums"><%= @summary[:not_required] %></div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="text-xs uppercase text-slate-500">Total purified (done)</div>
    <div class="mt-1 text-2xl font-semibold text-slate-900 tabular-nums"><%= number_with_precision(@summary[:amount_done], precision: 2, delimiter: ",") %></div>
  </div>
</div>

<% if @entries.empty? %>
  <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
    <p class="text-slate-600">No purification entries yet.</p>
    <p class="mt-1 text-sm text-slate-500">
      Use <span class="font-medium">Refresh all</span> above to generate the list for completed quarters
      (entries only appear once a quarter has fully ended).
    </p>
  </div>
<% else %>
  <% @grouped.each do |portfolio, by_asset| %>
    <section class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-2">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
          <%= portfolio.name %>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">
            <%= portfolio.purification_method == "aaoifi" ? "AAOIFI · quarterly" : "SP · whole period" %>
          </span>
        </h2>
        <%= button_to "Refresh this portfolio",
              generate_purification_entries_path(portfolio_id: portfolio.id, status: @selected_status),
              method: :post,
              class: "rounded-md bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200" %>
      </div>

      <% by_asset.each do |asset, entries| %>
        <h3 class="mt-5 text-sm font-semibold text-slate-700"><%= asset.name %> <span class="font-normal text-slate-400">(<%= asset.code %>)</span></h3>
        <div class="mt-2 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
          <table class="w-full min-w-[56rem] text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
              <tr>
                <th class="px-3 py-2">Period</th>
                <th class="px-3 py-2 text-right">Quantity</th>
                <th class="px-3 py-2 text-right">Days</th>
                <th class="px-3 py-2 text-right">Share-days</th>
                <th class="px-3 py-2">Status</th>
                <th class="px-3 py-2 text-right">Amount</th>
                <th class="px-3 py-2">Done on</th>
                <th class="px-3 py-2">Notes</th>
                <th class="px-3 py-2"></th>
              </tr>
            </thead>
            <tbody>
              <% entries.each do |e| %>
                <% fid = "pe_#{e.id}" %>
                <tr class="border-t border-slate-100 align-middle">
                  <td class="px-3 py-2">
                    <%= form_with url: purification_entry_path(e), method: :patch, id: fid do %>
                      <%= hidden_field_tag :portfolio_id, @selected_portfolio_id, id: nil %>
                      <%= hidden_field_tag :status, @selected_status, id: nil %>
                    <% end %>
                    <div class="font-medium text-slate-900"><%= e.quarter %></div>
                    <div class="text-xs text-slate-500"><%= e.period_start %> → <%= e.period_end %></div>
                  </td>
                  <td class="px-3 py-2 text-right tabular-nums"><%= number_with_precision(e.quantity, precision: 4, strip_insignificant_zeros: true) %></td>
                  <td class="px-3 py-2 text-right tabular-nums"><%= e.days %></td>
                  <td class="px-3 py-2 text-right tabular-nums"><%= number_with_precision(e.share_days, precision: 2, delimiter: ",") %></td>
                  <td class="px-3 py-2">
                    <%= select_tag "purification_entry[status]",
                          options_for_select(PurificationEntry::STATUSES.map { |s| [s.humanize, s] }, e.status),
                          form: fid,
                          class: "rounded-md border border-slate-300 px-2 py-1 text-sm" %>
                  </td>
                  <td class="px-3 py-2 text-right whitespace-nowrap">
                    <%= number_field_tag "purification_entry[amount]", e.amount, step: "0.00000001", form: fid,
                          class: "w-28 rounded-md border border-slate-300 px-2 py-1 text-right text-sm tabular-nums" %>
                    <span class="ml-1 text-xs text-slate-400"><%= e.asset_lot.currency.code %></span>
                  </td>
                  <td class="px-3 py-2">
                    <%= date_field_tag "purification_entry[done_on]", e.done_on, form: fid,
                          class: "rounded-md border border-slate-300 px-2 py-1 text-sm" %>
                  </td>
                  <td class="px-3 py-2">
                    <%= text_field_tag "purification_entry[notes]", e.notes, form: fid, placeholder: "—",
                          class: "w-40 rounded-md border border-slate-300 px-2 py-1 text-sm" %>
                  </td>
                  <td class="px-3 py-2 text-right">
                    <%= button_tag "Save", form: fid,
                          class: "rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  <% end %>
<% end %>
