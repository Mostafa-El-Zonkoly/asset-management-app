<% content_for :title, @asset.code %>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold"><%= @asset.name %></h1>
    <p class="font-mono text-sm text-slate-600"><%= @asset.code %></p>
    <p class="mt-2 text-sm">
      <span class="rounded bg-slate-200 px-2 py-0.5"><%= @asset.asset_type.label %></span>
      <% if @asset.sector %>
        <span class="text-slate-500">·</span>
        <%= @asset.sector.label %>
        <% if @asset.speciality %> → <%= @asset.speciality.label %><% end %>
      <% end %>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Add transaction", new_transaction_path(asset_id: @asset.id), class: "rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
    <%= link_to "Add price", prices_path(asset_id: @asset.id, return_to: "asset", anchor: "add-price"), class: "rounded-md bg-slate-800 px-3 py-2 text-sm font-medium text-white hover:bg-slate-900" %>
    <%= button_to "Fetch price", fetch_price_asset_path(@asset), method: :post, class: "rounded-md bg-slate-800 px-3 py-2 text-sm font-medium text-white hover:bg-slate-900" %>
    <%= link_to "Edit", edit_asset_path(@asset), class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
</div>

<% unless @asset.wallet? %>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3 font-medium">Holdings by portfolio</div>
    <% if @holdings.any? %>
      <% is_foreign = @reporting_currency && @asset.currency_id != @reporting_currency.id %>
      <% base_code = @reporting_currency&.code %>
      <table data-controller="sortable-table" class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">Portfolio</th>
            <th class="px-4 py-2 text-right">Quantity</th>
            <th class="px-4 py-2 text-right">Avg buy (<%= @asset.currency.code %>)</th>
            <% if is_foreign %>
              <th class="px-4 py-2 text-right">Avg buy (<%= base_code %>)</th>
            <% end %>
            <th class="px-4 py-2 text-right">Value (<%= base_code || "—" %>)</th>
            <th class="px-4 py-2 text-right">Unrealised (<%= base_code || "—" %>)</th>
          </tr>
        </thead>
        <tbody>
          <% @holdings.each do |h| %>
            <% r = HoldingsCalculatorService.for_holding(h) %>
            <% avg_buy_in_base = h.quantity.to_d.nonzero? ? (r.cost_basis / h.quantity.to_d) : nil %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-2"><%= link_to h.portfolio.name, h.portfolio, class: "text-blue-600 hover:underline" %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(h.quantity, precision: 4) %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= h.average_buy_price ? number_with_precision(h.average_buy_price, precision: 4) : "—" %></td>
              <% if is_foreign %>
                <td class="px-4 py-2 text-right tabular-nums"><%= avg_buy_in_base ? number_with_precision(avg_buy_in_base, precision: 2) : "—" %></td>
              <% end %>
              <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(r.current_value, precision: 2) %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(r.unrealised_gain, precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="border-t border-slate-100 px-4 py-2 text-xs text-slate-500">Value and unrealised are in the <%= link_to "reporting currency", settings_currencies_path, class: "text-blue-600 underline" %> (same as portfolio totals).</p>
    <% else %>
      <p class="px-4 py-4 text-sm text-slate-600">No positions yet. Record a buy in <%= link_to "Transactions", new_transaction_path, class: "text-blue-600 underline" %> to open a holding.</p>
    <% end %>
  </div>
<% end %>

<% is_foreign_asset = @reporting_currency && @asset.currency_id != @reporting_currency.id %>
<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% @stats.each do |k, v| %>
    <% key = k.to_sym %>
    <% unit =
         case key
         when :current_price, :average_buy_price
           @asset.currency.code
         when :current_value, :unrealised_gain, :realised_gain, :total_dividends
           @reporting_currency&.code
         end %>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs uppercase text-slate-500"><%= k.to_s.humanize %><% if unit.present? %> <span class="font-normal normal-case text-slate-400">(<%= unit %>)</span><% end %></p>
      <p class="mt-1 font-semibold tabular-nums"><%= format_stat_card_value(k, v, precision: 4) %></p>
    </div>
  <% end %>

  <% if is_foreign_asset %>
    <%
      base_id   = @reporting_currency.id
      base_code = @reporting_currency.code
      current_price_in_base = @stats[:current_price] ?
        CurrencyConversionService.convert(@stats[:current_price], @asset.currency_id, base_id) : nil
      total_qty  = @holdings.sum { |h| h.quantity.to_d }
      total_cost = @holdings.sum { |h| HoldingsCalculatorService.for_holding(h).cost_basis }
      avg_buy_in_base = total_qty.nonzero? ? (total_cost / total_qty) : nil
    %>
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-4 shadow-sm">
      <p class="text-xs uppercase text-slate-500">Current price <span class="font-normal normal-case text-slate-400">(<%= base_code %>)</span></p>
      <p class="mt-1 font-semibold tabular-nums">
        <%= current_price_in_base ? number_with_precision(current_price_in_base, precision: 2) : "—" %>
      </p>
    </div>
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-4 shadow-sm">
      <p class="text-xs uppercase text-slate-500">Avg buy price <span class="font-normal normal-case text-slate-400">(<%= base_code %>, at purchase rates)</span></p>
      <p class="mt-1 font-semibold tabular-nums">
        <%= avg_buy_in_base ? number_with_precision(avg_buy_in_base, precision: 2) : "—" %>
      </p>
    </div>
  <% end %>
</div>

<div
  class="mt-8 rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
  data-controller="line-chart"
  data-line-chart-url-value="<%= api_asset_prices_path(@asset.id, range: @chart_range) %>"
>
  <h2 class="font-medium">Price history</h2>
  <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-2 text-xs">
    <% AssetsController::CHART_RANGE_KEYS.each do |r| %>
      <% active = @chart_range == r %>
      <span class="inline-flex items-baseline gap-1.5">
        <%= link_to r.upcase,
              asset_path(@asset, chart_range: r),
              **(active ? { aria: { current: "page" } } : {}),
              class: [
                "inline-block rounded px-2 py-1 font-medium no-underline",
                active ? "bg-blue-600 text-white hover:bg-blue-700" : "bg-slate-100 text-slate-700 hover:bg-slate-200"
              ].join(" ") %>
        <%= format_pnl_percent(@range_interval_pct[r], precision: 2) %>
      </span>
    <% end %>
  </div>
  <div class="mt-3 min-h-[2.75rem]" data-line-chart-target="summary"></div>
  <canvas class="mt-4 max-h-72" data-line-chart-target="canvas"></canvas>
  <div class="mt-6 border-t border-slate-100 pt-4">
    <h3 class="text-sm font-medium text-slate-800">Prices in this range</h3>
    <div class="mt-2 max-h-64 overflow-auto rounded-md border border-slate-100">
      <% if @chart_prices.empty? %>
        <p class="p-3 text-sm text-slate-500">No prices in this range. <%= link_to "Add a price", prices_path(asset_id: @asset.id, return_to: "asset", anchor: "add-price"), class: "text-blue-600 underline" %>.</p>
      <% else %>
        <table data-controller="sortable-table" class="w-full text-left text-sm">
          <thead class="sticky top-0 bg-slate-50 text-xs uppercase text-slate-500">
            <tr>
              <th class="px-3 py-2">Date</th>
              <th class="px-3 py-2 text-right">Change (%)</th>
              <th class="px-3 py-2 text-right">Price (<%= @asset.currency.code %>)</th>
            </tr>
          </thead>
          <tbody>
            <% @prices_page_rows.each do |row| %>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2 whitespace-nowrap"><%= l Date.parse(row[:date]), format: :long %></td>
                <td class="px-3 py-2 text-right tabular-nums"><%= format_pnl_percent(row[:change_pct], precision: 2) %></td>
                <td class="px-3 py-2 text-right tabular-nums"><%= number_with_precision(row[:price], precision: 4) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @prices_total_pages > 1 %>
          <div class="flex items-center justify-between border-t border-slate-100 px-3 py-2 text-xs text-slate-600">
            <p>Page <%= @prices_page %> of <%= @prices_total_pages %></p>
            <div class="flex items-center gap-2">
              <% if @prices_page > 1 %>
                <%= link_to "Previous",
                      asset_path(@asset, chart_range: @chart_range, prices_page: @prices_page - 1),
                      class: "rounded border border-slate-300 px-2 py-1 hover:bg-slate-50" %>
              <% else %>
                <span class="rounded border border-slate-200 px-2 py-1 text-slate-400">Previous</span>
              <% end %>
              <% if @prices_page < @prices_total_pages %>
                <%= link_to "Next",
                      asset_path(@asset, chart_range: @chart_range, prices_page: @prices_page + 1),
                      class: "rounded border border-slate-300 px-2 py-1 hover:bg-slate-50" %>
              <% else %>
                <span class="rounded border border-slate-200 px-2 py-1 text-slate-400">Next</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% if @asset.market_index_id.present? %>
  <div class="mt-6 text-sm text-slate-600">Index comparison: <%= @asset.market_index.code %> — use API <%= api_asset_index_prices_path(@asset.id) %> for overlay (extend chart as needed).</div>
<% end %>

<div class="mt-8 rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 px-4 py-3 font-medium">Transactions</div>
  <table data-controller="sortable-table" class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase text-slate-500">
      <tr>
        <th class="px-4 py-2">Date</th>
        <th class="px-4 py-2">Portfolio</th>
        <th class="px-4 py-2">Type</th>
        <th class="px-4 py-2 text-right">Quantity</th>
        <th class="px-4 py-2 text-right">Unit price</th>
        <th class="px-4 py-2 text-right">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @transactions.each do |t| %>
        <tr class="border-t border-slate-100">
          <td class="px-4 py-2 whitespace-nowrap"><%= l t.date.to_date %></td>
          <td class="px-4 py-2"><%= t.portfolio&.name || "—" %></td>
          <td class="px-4 py-2"><%= link_to t.transaction_type.label, transaction_path(t), class: "text-blue-600 hover:underline" %></td>
          <td class="px-4 py-2 text-right tabular-nums">
            <%= t.quantity.to_d.nonzero? ? number_with_precision(t.quantity, precision: 4) : "—" %>
          </td>
          <td class="px-4 py-2 text-right tabular-nums">
            <%= t.price_per_unit ? "#{number_with_precision(t.price_per_unit, precision: 4)} #{t.currency.code}" : "—" %>
          </td>
          <td class="px-4 py-2 text-right tabular-nums">
            <%= number_with_precision(t.total_amount, precision: 2) %> <%= t.currency.code %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
