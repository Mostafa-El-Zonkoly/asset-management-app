<% content_for :title, "Asset summary" %>
<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Asset summary</h1>
    <p class="mt-1 text-sm text-slate-600">Positions with quantity &gt; 0 (non-wallet). Amount, gain/loss, and weight use the reporting currency<% if @reporting_currency %> (<%= @reporting_currency.code %>)<% end %>.</p>
  </div>
  <%= link_to "All assets", assets_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50" %>
</div>

<% if @rows.any? %>
  <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table data-controller="sortable-table" class="w-full min-w-[1000px] text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">Asset name</th>
          <th class="px-3 py-2">Asset code</th>
          <th class="px-3 py-2 text-right">Quantity</th>
          <th class="px-3 py-2 text-right">Amount</th>
          <th class="px-3 py-2 text-right">Total gain/loss %</th>
          <th class="px-3 py-2 text-right">Weight</th>
          <th class="px-3 py-2 text-right">Zakaa %</th>
          <th class="px-3 py-2">Portfolios</th>
          <th class="px-3 py-2">Asset type</th>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <% a = row.asset %>
          <tr class="border-t border-slate-100">
            <td class="px-3 py-2"><%= link_to a.name, a, class: "text-blue-600 hover:underline" %></td>
            <td class="px-3 py-2 font-mono"><%= link_to a.code, a, class: "text-blue-600 hover:underline" %></td>
            <td class="px-3 py-2 text-right tabular-nums"><%= number_with_precision(row.quantity, precision: 4) %></td>
            <td class="px-3 py-2 text-right tabular-nums"><%= number_with_precision(row.current_value, precision: 2) %></td>
            <td class="px-3 py-2 text-right"><%= format_pnl_percent(row.total_gain_pct, precision: 2) %></td>
            <td class="px-3 py-2 text-right tabular-nums"><%= row.weight_pct ? "#{number_with_precision(row.weight_pct, precision: 2)}%" : "—" %></td>
            <td class="px-3 py-2 text-right tabular-nums"><%= number_with_precision(a.zaka_percentage, precision: 2) %>%</td>
            <td class="px-3 py-2 text-slate-700"><%= row.portfolio_names.presence || "—" %></td>
            <td class="max-w-xs px-3 py-2 text-slate-700"><%= row.type_descriptor.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-slate-500">Weight is each line’s current value as a share of the total current value of all rows on this page.</p>
<% else %>
  <p class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600 shadow-sm">No holdings with quantity yet. Add buys from <%= link_to "Transactions", transactions_path, class: "text-blue-600 underline" %>.</p>
<% end %>
