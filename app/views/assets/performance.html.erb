<% content_for :title, "Asset performance" %>
<h1 class="text-2xl font-semibold">Asset performance</h1>
<p class="mt-2 max-w-3xl text-sm text-slate-600">
  Active direct stocks you <span class="font-medium">currently hold</span> (net quantity &gt; 0 across portfolios).
  Pick a <span class="font-medium">date range</span> (inclusive). <span class="font-medium">Change</span> uses the
  <span class="font-medium">latest stored quote inside the range</span> minus the
  <span class="font-medium">latest stored quote strictly before the range start</span> (same currency as the asset).
  When the range is a single day, that matches “this day vs prior quote.”
  <span class="font-medium">Fetch prices</span> loads quotes for the <span class="font-medium">range end date</span> only (same pipeline as the Prices page).
</p>

<div class="mt-6 flex flex-wrap items-end gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <%= form_with url: performance_assets_path, method: :get, local: true, class: "flex flex-wrap items-end gap-4" do %>
    <label class="block text-sm font-medium text-slate-700">
      From
      <%= date_field_tag :from, @range_from.iso8601, class: "mt-1 block rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </label>
    <label class="block text-sm font-medium text-slate-700">
      To
      <%= date_field_tag :to, @range_to.iso8601, class: "mt-1 block rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </label>
    <%= submit_tag "Show", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
  <% end %>

  <%= button_to "Fetch prices (end date)",
                fetch_prices_path(
                  date: @range_to.iso8601,
                  return_to: "asset_performance",
                  from: @range_from.iso8601,
                  to: @range_to.iso8601
                ),
                method: :post,
                class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-900" %>
</div>

<% if @rows.empty? %>
  <p class="mt-8 text-sm text-slate-600">No active direct stocks with a current holding (net quantity &gt; 0).</p>
<% else %>
  <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table data-controller="sortable-table" class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-2">Code</th>
          <th class="px-4 py-2">Name</th>
          <th class="px-4 py-2">Prior date</th>
          <th class="px-4 py-2">Prior price</th>
          <th class="px-4 py-2">In-range date</th>
          <th class="px-4 py-2">In-range price</th>
          <th class="px-4 py-2">Change</th>
          <th class="px-4 py-2">Change %</th>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-2 font-medium">
              <%= link_to row.asset.code, row.asset, class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-2 text-slate-700"><%= row.asset.name %></td>
            <td class="px-4 py-2 tabular-nums text-slate-600"><%= row.prior_price&.date&.iso8601 || "—" %></td>
            <td class="px-4 py-2 tabular-nums">
              <% if row.prior_price %>
                <%= number_with_precision(row.prior_price.price, precision: 6) %> <%= row.asset.currency.code %>
              <% else %>
                <span class="text-slate-500">—</span>
              <% end %>
            </td>
            <td class="px-4 py-2 tabular-nums text-slate-600"><%= row.day_price&.date&.iso8601 || "—" %></td>
            <td class="px-4 py-2 tabular-nums">
              <% if row.day_price %>
                <%= number_with_precision(row.day_price.price, precision: 6) %> <%= row.asset.currency.code %>
              <% else %>
                <span class="text-slate-500">—</span>
              <% end %>
            </td>
            <td class="px-4 py-2 tabular-nums">
              <%= format_pnl_value(row.change, precision: 6) %>
            </td>
            <td class="px-4 py-2 tabular-nums">
              <%= format_pnl_percent(row.change_pct, precision: 2) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
