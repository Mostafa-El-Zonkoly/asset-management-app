<%# locals: summary (AssetEstimateSummaryService::Result), asset, manage: bool %>
<% sections = [[:fundamental, "Fundamental"], [:consensus, "Analyst consensus"], [:technical, "Technical targets"]] %>
<% any = summary.sections.values.any?(&:present?) %>
<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex items-center justify-between">
    <h2 class="font-medium text-slate-900">Valuation &amp; Targets</h2>
    <div class="flex items-center gap-3 text-xs">
      <span class="text-slate-500">Current
        <span class="font-semibold tabular-nums text-slate-800"><%= summary.current_price ? number_with_precision(summary.current_price, precision: 2) : "—" %></span>
        <%= summary.currency_code %>
      </span>
      <% if local_assigns[:manage] %>
        <%= link_to "Add estimate", new_asset_estimate_path(asset), class: "rounded-md bg-blue-600 px-2.5 py-1 font-medium text-white hover:bg-blue-700" %>
      <% else %>
        <%= link_to "Manage", asset_estimates_path(asset), class: "text-blue-600 hover:underline" %>
      <% end %>
    </div>
  </div>

  <% unless any %>
    <p class="mt-3 text-sm text-slate-500">No estimates yet. <%= link_to "Add one", new_asset_estimate_path(asset), class: "text-blue-600 hover:underline" %> to track fundamental, consensus, and technical targets separately.</p>
  <% end %>

  <div class="mt-3 grid gap-3 lg:grid-cols-3">
    <% sections.each do |key, title| %>
      <% aggs = summary.sections[key] %>
      <% next if aggs.blank? %>
      <div class="rounded-lg border border-slate-200 p-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= title %></p>
        <% aggs.each do |a| %>
          <div class="mt-2 border-t border-slate-100 pt-2 first:border-0 first:pt-0">
            <div class="flex items-center justify-between text-[11px] text-slate-500">
              <span><%= a.horizon_type ? AssetEstimate::HORIZON_TYPE_LABELS[a.horizon_type] : "" %></span>
              <span>
                Sources <span class="font-semibold text-slate-700"><%= a.raw_count %></span>
                · Independent <span class="font-semibold text-slate-700"><%= a.independent_count %></span>
              </span>
            </div>
            <% if a.not_independent %>
              <p class="mt-0.5 rounded bg-amber-50 px-1.5 py-0.5 text-[10px] text-amber-700" title="Some sources share a source family (same underlying dataset) and are counted once.">⚠ Not fully independent — duplicate source families collapsed.</p>
            <% end %>

            <% if key == :technical %>
              <table class="mt-1.5 w-full text-xs tabular-nums">
                <tr><td class="text-slate-500">Nearest</td><td class="text-right font-medium"><%= number_with_precision(a.nearest, precision: 2) %></td><td class="text-right <%= pnl_class_for(a.nearest_upside) %>"><%= format_upside(a.nearest_upside) %></td></tr>
                <tr><td class="text-slate-500">Median</td><td class="text-right font-semibold"><%= number_with_precision(a.median, precision: 2) %></td><td class="text-right <%= pnl_class_for(a.median_upside) %>"><%= format_upside(a.median_upside) %></td></tr>
                <tr><td class="text-slate-500">Max</td><td class="text-right font-medium"><%= number_with_precision(a.max, precision: 2) %></td><td class="text-right <%= pnl_class_for(a.max_upside) %>"><%= format_upside(a.max_upside) %></td></tr>
              </table>
            <% else %>
              <table class="mt-1.5 w-full text-xs tabular-nums">
                <tr><td class="text-slate-500" title="Minimum target">Conservative</td><td class="text-right font-medium"><%= number_with_precision(a.min, precision: 2) %></td><td class="text-right <%= pnl_class_for(a.min_upside) %>"><%= format_upside(a.min_upside) %></td></tr>
                <tr><td class="text-slate-500" title="Median target — the headline figure">Median</td><td class="text-right font-semibold text-slate-900"><%= number_with_precision(a.median, precision: 2) %></td><td class="text-right font-semibold <%= pnl_class_for(a.median_upside) %>"><%= format_upside(a.median_upside) %></td></tr>
                <tr><td class="text-slate-500">Weighted avg</td><td class="text-right font-medium"><%= number_with_precision(a.weighted_avg, precision: 2) %></td><td class="text-right <%= pnl_class_for(a.weighted_upside) %>"><%= format_upside(a.weighted_upside) %></td></tr>
                <tr><td class="text-slate-500" title="Maximum target">Optimistic</td><td class="text-right font-medium"><%= number_with_precision(a.max, precision: 2) %></td><td class="text-right <%= pnl_class_for(a.max_upside) %>"><%= format_upside(a.max_upside) %></td></tr>
              </table>
            <% end %>

            <details class="mt-1.5">
              <summary class="cursor-pointer text-[11px] text-blue-600 hover:underline">Individual estimates (<%= a.all_rows.size %>)</summary>
              <table class="mt-1 w-full text-[11px] tabular-nums">
                <thead class="text-slate-400"><tr><th class="text-left font-normal">Source</th><th class="text-right font-normal">Target</th><th class="text-right font-normal">Date</th><th class="text-right font-normal">Fresh</th></tr></thead>
                <tbody>
                  <% a.all_rows.each do |r| %>
                    <tr class="border-t border-slate-50">
                      <td class="text-slate-600"><%= r.source_name %><% if r.source_family.present? %><span class="text-slate-400" title="Source family"> · <%= r.source_family %></span><% end %></td>
                      <td class="text-right"><%= number_with_precision(r.target_price, precision: 2) %> <%= r.currency.code %></td>
                      <td class="text-right text-slate-500"><%= l r.estimate_date %></td>
                      <td class="text-right"><%= freshness_badge(r.freshness(summary.as_of)) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </details>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if any %>
    <p class="mt-2 text-[11px] text-slate-400">Aggregates use one representative per source family<%= summary.exclude_stale ? "; stale estimates excluded" : "" %>. Median is the base case; horizons and types are never mixed.</p>
  <% end %>
</div>
