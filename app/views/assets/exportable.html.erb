<% content_for :title, "Exportable assets" %>
<%
  order   = AssetsController::EXPORT_LAYOUTS[@layout]
  headers = AssetsController::EXPORT_HEADERS
  rcy     = @reporting_currency&.code

  avg_price = ->(r) { r.quantity.to_d.nonzero? ? (r.cost.to_d / r.quantity.to_d) : nil }
  cur_price = ->(r) { r.quantity.to_d.nonzero? ? (r.current_value.to_d / r.quantity.to_d) : nil }

  # Per-column cell html for a row.
  cell = lambda do |key, r|
    case key
    when :avg_price      then (v = avg_price.call(r)) ? number_with_precision(v, precision: 4, delimiter: ",") : "—"
    when :current_price  then (v = cur_price.call(r)) ? number_with_precision(v, precision: 4, delimiter: ",") : "—"
    when :weight         then r.weight_pct ? "#{number_with_precision(r.weight_pct, precision: 2)}%" : "—"
    when :profit         then format_pnl_percent(r.total_gain_pct, precision: 2)
    when :current_amount then number_with_precision(r.current_value, precision: 2, delimiter: ",")
    when :purchase       then number_with_precision(r.cost, precision: 2, delimiter: ",")
    when :quantity       then number_with_precision(r.quantity, precision: 4, strip_insignificant_zeros: true)
    end
  end
  # Numeric sort value for a column.
  sortval = lambda do |key, r|
    case key
    when :avg_price      then avg_price.call(r).to_f
    when :current_price  then cur_price.call(r).to_f
    when :weight         then r.weight_pct.to_f
    when :profit         then r.total_gain_pct.to_f
    when :current_amount then r.current_value.to_f
    when :purchase       then r.cost.to_f
    when :quantity       then r.quantity.to_f
    end
  end
  # Footer total for a column (blank where a total is meaningless).
  foot = lambda do |key|
    case key
    when :weight         then "#{number_with_precision(@rows.sum { |r| r.weight_pct.to_d }, precision: 2)}%"
    when :current_amount then number_with_precision(@rows.sum { |r| r.current_value.to_d }, precision: 2, delimiter: ",")
    when :purchase       then number_with_precision(@rows.sum { |r| r.cost.to_d }, precision: 2, delimiter: ",")
    end
  end

  base_filters = { name: @name.presence, position_role: @position_role, portfolio_ids: @selected_portfolio_ids }.compact
  csv_params   = base_filters.merge(format: :csv, layout: @layout)
%>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Exportable assets</h1>
    <p class="mt-1 text-sm text-slate-600">One row per ticker with average and current price, P/L, weight and amounts<% if rcy %> (<%= rcy %>)<% end %>. Filter, pick a column order, then export to CSV.</p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Export CSV", exportable_assets_path(csv_params), class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
    <%= link_to "Asset summary", summary_assets_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50" %>
  </div>
</div>

<%= form_with url: exportable_assets_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do %>
  <%= hidden_field_tag :layout, @layout %>
  <div>
    <label class="block text-xs font-medium uppercase text-slate-500">Name / ticker</label>
    <%= text_field_tag :name, @name, placeholder: "Search…", class: "mt-1 rounded-md border border-slate-300 px-3 py-1.5 text-sm" %>
  </div>
  <div>
    <label class="block text-xs font-medium uppercase text-slate-500">Position</label>
    <%= select_tag :position_role,
          options_for_select([["All", "all"], ["Base", "base"], ["Temporary", "temporary"]], @position_role),
          class: "mt-1 rounded-md border border-slate-300 px-3 py-1.5 text-sm" %>
  </div>
  <% if @portfolios.present? %>
    <div class="min-w-[16rem] flex-1">
      <label class="block text-xs font-medium uppercase text-slate-500">Portfolios <span class="font-normal normal-case text-slate-400">(active only · none = all)</span></label>
      <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
        <% @portfolios.each do |p| %>
          <label class="inline-flex items-center gap-1.5 text-sm">
            <%= check_box_tag "portfolio_ids[]", p.id, @selected_portfolio_ids.include?(p.id), class: "rounded border-slate-300" %>
            <span><%= p.name %></span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
  <%= submit_tag "Apply", class: "rounded-md bg-slate-100 px-4 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-200" %>
  <% if @name.present? || @selected_portfolio_ids.present? || @position_role != "all" %>
    <%= link_to "Clear", exportable_assets_path(layout: @layout), class: "px-2 py-1.5 text-sm text-blue-600 hover:underline" %>
  <% end %>
<% end %>

<%# Column-order switch %>
<div class="mt-4 flex items-center gap-2 text-sm">
  <span class="text-xs font-medium uppercase text-slate-500">Column order</span>
  <% [["a", "Price-first"], ["b", "Amount-first"]].each do |key, label| %>
    <%= link_to label, exportable_assets_path(base_filters.merge(layout: key)),
          class: "rounded px-2.5 py-1 text-xs font-medium #{@layout == key ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}" %>
  <% end %>
  <span class="text-xs text-slate-400 truncate">Ticker · <%= order.map { |k| headers[k] }.join(" · ") %></span>
</div>

<% if @rows.any? %>
  <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table data-controller="sortable-table" class="w-full min-w-[60rem] text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">Ticker</th>
          <% order.each do |key| %>
            <th class="px-3 py-2 text-right"><%= headers[key] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <% a = row.asset %>
          <tr class="border-t border-slate-100">
            <td class="px-3 py-2 font-mono"><%= link_to a.code, a, class: "text-blue-600 hover:underline" %></td>
            <% order.each do |key| %>
              <td class="px-3 py-2 text-right <%= 'tabular-nums' unless key == :profit %>" data-sort-value="<%= sortval.call(key, row) %>"><%= cell.call(key, row) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-slate-200 bg-slate-50 text-sm font-medium">
        <tr>
          <td class="px-3 py-2">Total (<%= @rows.size %>)</td>
          <% order.each do |key| %>
            <td class="px-3 py-2 text-right tabular-nums"><%= foot.call(key) %></td>
          <% end %>
        </tr>
      </tfoot>
    </table>
  </div>
  <p class="mt-3 text-xs text-slate-500">Average and current price are per unit in <%= rcy %> (total ÷ quantity). Weight is each ticker's current amount as a share of the filtered total.</p>
<% else %>
  <p class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600 shadow-sm">No holdings match these filters.</p>
<% end %>
