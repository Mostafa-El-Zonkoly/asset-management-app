<%# locals: (metrics:, reporting_currency:) %>
<% fc = metrics %>
<div class="rounded-md border border-emerald-200/80 bg-slate-50 p-3">
  <p class="text-xs font-semibold uppercase tracking-wide text-emerald-900">Whole portfolio target — free cash</p>
  <p class="mt-0.5 text-xs text-slate-600">Wallet cash as a share of <strong>total wealth</strong> (included portfolio investments + all <%= link_to "wallets", wallets_path, class: "text-blue-600 hover:underline" %>), same denominator as “% combined”.</p>
  <dl class="mt-3 grid gap-2 text-sm md:grid-cols-2">
    <dt class="text-slate-600">Actual (balance)</dt>
    <dd class="font-medium tabular-nums"><%= number_with_precision(fc[:actual], precision: 2) %> <%= reporting_currency&.code %></dd>
    <dt class="text-slate-600">Actual (% of wealth)</dt>
    <dd class="font-medium tabular-nums"><%= number_with_precision(fc[:actual_pct], precision: 2) %>%</dd>
    <% if fc[:target_pct].present? %>
      <dt class="text-slate-600">Target (% of wealth)</dt>
      <dd class="font-medium tabular-nums"><%= number_with_precision(fc[:target_pct], precision: 2) %>%</dd>
      <dt class="text-slate-600">Deviation (percentage points)</dt>
      <dd><%= format_target_deviation_percent(fc[:deviation_pct], precision: 2) %></dd>
      <dt class="text-slate-600">Deviation (value)</dt>
      <dd><%= format_target_deviation_value(fc[:deviation_amount], deviation_pct: fc[:deviation_pct], precision: 2) %> <%= reporting_currency&.code %></dd>
    <% else %>
      <dt class="text-slate-600">Target</dt>
      <dd class="text-slate-600"><%= link_to "Set a target percentage", edit_settings_free_cash_target_path, class: "text-blue-600 hover:underline" %> of wealth to hold as cash.</dd>
    <% end %>
  </dl>
</div>
