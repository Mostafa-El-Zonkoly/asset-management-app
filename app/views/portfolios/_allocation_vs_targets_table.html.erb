<%# locals: (allocation:, reporting_currency:) %>
<% if allocation.blank? %>
  <p class="text-sm text-slate-600">No category allocation yet (add non-wallet holdings).</p>
<% else %>
  <table data-controller="sortable-table" class="w-full min-w-[42rem] text-left text-sm">
    <thead class="text-xs uppercase text-slate-500">
      <tr>
        <th class="py-2 pr-2">Category</th>
        <th class="pr-2">Actual<% if reporting_currency %> (<%= reporting_currency.code %>)<% end %></th>
        <th class="pr-2">Target</th>
        <th class="pr-2">% of target</th>
        <th class="pr-2">Mix %</th>
        <th>Deviation</th>
      </tr>
    </thead>
    <tbody>
      <% allocation.each do |row| %>
        <tr class="border-t border-slate-100">
          <td class="py-2 font-medium text-slate-900"><%= row[:category] %></td>
          <td class="tabular-nums"><%= number_with_precision(row[:value], precision: 2) %></td>
          <td class="tabular-nums text-slate-700">
            <% if row[:target_pct].present? %>
              <%= number_with_precision(row[:target_pct], precision: 2) %>% <span class="text-xs text-slate-500">(mix)</span>
            <% elsif row[:target_amount].present? %>
              <%= number_with_precision(row[:target_amount], precision: 2) %><% if reporting_currency %> <%= reporting_currency.code %><% end %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="tabular-nums">
            <% if row[:static_achieved_pct].present? %>
              <span class="font-medium text-slate-900"><%= number_with_precision(row[:static_achieved_pct], precision: 1) %>%</span>
            <% else %>
              <span class="text-slate-500">—</span>
            <% end %>
          </td>
          <td class="tabular-nums text-slate-600"><%= number_with_precision(row[:actual_pct], precision: 2) %>%</td>
          <td class="tabular-nums">
            <% if row[:deviation_pct].present? %>
              <%= format_target_deviation_percent(row[:deviation_pct], precision: 2) %> <span class="text-xs text-slate-500">(pts)</span>
            <% elsif row[:deviation_amount].present? %>
              <%= format_target_deviation_value(row[:deviation_amount], target_amount: row[:target_amount], precision: 2) %>
            <% else %>
              <span class="text-slate-500">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="mt-3 text-xs text-slate-500"><span class="font-medium text-slate-700">% of target</span> applies to static-amount targets: (category value ÷ target amount) × 100. <span class="font-medium text-slate-700">Mix %</span> is that category’s share of this portfolio’s total value.</p>
<% end %>
