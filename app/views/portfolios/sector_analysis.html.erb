<% content_for :title, "Sector analysis" %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900">Sector analysis — <%= @selected_portfolio_ids.any? ? "selected portfolios" : "all portfolios" %></h1>
    <p class="mt-1 text-sm text-slate-600">
      Direct stock holdings with a sector assigned, aggregated across all portfolios.
      <strong>Actual %</strong> is each sector's share of total sectored assets.
      <strong>Actual %</strong> is within the current filter; <strong>Overall %</strong> is the same weight across all portfolios (ignoring the filter).
      <strong>Guideline Cap %</strong> is a soft risk limit (maximum preferred exposure), not an allocation target — set it with the pencil. <strong>Room to Cap</strong> is the remaining risk capacity before the cap; positive room does not mean you should buy more.
      Click any column header to sort.
    </p>
  </div>
  <%= link_to "By sector + speciality", sector_speciality_analysis_portfolios_path(portfolio_ids: @selected_portfolio_ids, position_role: @position_role), class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
</div>

<%= render "portfolios/portfolio_filter", url: sector_analysis_portfolios_path, portfolios: @portfolios, selected_ids: @selected_portfolio_ids, position_role: @position_role %>

<% if @reporting_currency %>
  <p class="mt-4 text-sm text-slate-600">Figures in reporting currency <span class="font-medium"><%= @reporting_currency.code %></span>.</p>
<% end %>

<% if @missing_fx_codes&.any? %>
  <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
    Missing FX into reporting currency for: <strong><%= @missing_fx_codes.join(", ") %></strong>. Totals may be incomplete.
  </div>
<% end %>

<div class="mt-6 grid gap-4 sm:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Total sectored value</p>
    <p class="mt-1 text-xl font-semibold"><%= number_with_precision(@sectored_total, precision: 2) %> <%= @reporting_currency&.code %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500"><%= @selected_portfolio_ids.any? ? "Selected portfolios total" : "Included portfolios total" %></p>
    <p class="mt-1 text-xl font-semibold"><%= number_with_precision(@included_total, precision: 2) %> <%= @reporting_currency&.code %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Sectors</p>
    <p class="mt-1 text-xl font-semibold"><%= @sector_rows.size %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Sectors over cap</p>
    <% over = @sector_rows.count { |r|
         cap = (@targets_by_sector_id[r[:sector].id]&.target_percentage&.to_f) || default_sector_cap(r[:sector].label)
         cap && r[:pct_of_sectored].to_f > cap } %>
    <p class="mt-1 text-xl font-semibold <%= over.positive? ? 'text-red-600' : 'text-emerald-600' %>"><%= over %></p>
    <p class="mt-1 text-[11px] text-slate-400">Caps are independent risk limits and need not sum to 100%.</p>
  </div>
</div>

<details class="mt-6 rounded-xl border border-slate-200 bg-white p-4 text-sm shadow-sm">
  <summary class="cursor-pointer font-medium text-slate-700">How each column is calculated</summary>
  <dl class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
    <div><dt class="font-medium text-slate-800">Owned</dt><dd class="text-slate-600">Count of distinct direct-stock assets actually held (quantity &gt; 0) in the sector, within the current filter. A “+N watch” badge counts registered assets with quantity 0 (watchlist), which never affect value, weight or gain/loss.</dd></div>
    <div><dt class="font-medium text-slate-800">Value</dt><dd class="text-slate-600">Sum of current value of the sector's direct-stock holdings, in the reporting currency.</dd></div>
    <div><dt class="font-medium text-slate-800">Actual %</dt><dd class="text-slate-600">Sector value ÷ total sectored value, within the current filter. Sums to 100% across sectors.</dd></div>
    <div><dt class="font-medium text-slate-800">Overall %</dt><dd class="text-slate-600">Same share but across all portfolios, ignoring the filter — equals Actual % when nothing is filtered.</dd></div>
    <div><dt class="font-medium text-slate-800">Guideline Cap %</dt><dd class="text-slate-600">Maximum preferred exposure for portfolio risk management. This is <strong>not</strong> a target allocation. Caps are independent and need not sum to 100%.</dd></div>
    <div><dt class="font-medium text-slate-800">Room to Cap</dt><dd class="text-slate-600">Guideline Cap − Actual %, in percentage points — remaining risk capacity before the cap. Negative means the sector is over its cap. Positive room does <strong>not</strong> imply additional investment is required.</dd></div>
    <div><dt class="font-medium text-slate-800">Risk status</dt><dd class="text-slate-600">SAFE (≤ 80% of cap), WATCH (80% of cap up to the cap), or OVER CAP (above the cap). Below the cap is safe, not a buy signal.</dd></div>
    <div><dt class="font-medium text-slate-800">% of included</dt><dd class="text-slate-600">Sector value ÷ total value of the included (or selected) portfolios — share of the whole book, not just sectored assets.</dd></div>
    <div><dt class="font-medium text-slate-800">Gain/Loss %</dt><dd class="text-slate-600">Unrealised gain ÷ cost basis for the sector's holdings.</dd></div>
  </dl>
</details>

<% if @sector_rows.blank? %>
  <p class="mt-8 text-slate-500">No direct stock holdings with a sector assigned were found.</p>
<% else %>
  <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table id="sector-table" class="min-w-full text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="cursor-pointer select-none px-4 py-3 text-left hover:bg-slate-100" data-col="0" data-type="string">Sector <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="1" data-type="number">Owned <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="2" data-type="number">Value (<%= @reporting_currency&.code %>) <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="3" data-type="number">Actual % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="4" data-type="number">Overall % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="5" data-type="number" title="Maximum preferred exposure for portfolio risk management. This is not a target allocation.">Guideline Cap % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="6" data-type="number" title="Remaining exposure capacity before reaching the sector guideline. Positive room does not imply that additional investment is required.">Room to Cap <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="7" data-type="number">% of included <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="8" data-type="number">Gain/Loss % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="9" data-type="number" title="Base % / Temporary % of the sector's direct-stock value">Base / Temp <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-center hover:bg-slate-100" data-col="10" data-type="number">Risk status <span class="sort-icon text-slate-300">↕</span></th>
          <th class="px-4 py-3 text-center">Cap</th>
        </tr>
      </thead>
      <tbody id="sector-tbody" class="divide-y divide-slate-100">
        <% @sector_rows.each do |row| %>
          <% target = @targets_by_sector_id[row[:sector].id] %>
          <% actual_pct = row[:pct_of_sectored].to_f %>
          <% explicit_cap = target&.target_percentage&.to_f %>
          <% cap = explicit_cap || default_sector_cap(row[:sector].label) %>
          <% is_default_cap = explicit_cap.nil? && !cap.nil? %>
          <% room = cap ? (cap - actual_pct).round(2) : nil %>
          <% status = sector_risk_status(actual_pct, cap) %>
          <% status_label, status_text, status_hex = sector_risk_style(status) %>
          <% status_rank = { safe: 0, watch: 1, over: 2 }[status] %>
          <tr class="hover:bg-slate-50"
              data-vals="<%= [row[:sector].label, row[:asset_count], row[:value].to_f, actual_pct, row[:pct_of_sectored_overall].to_f, cap || -99999, room || -99999, row[:pct_of_included].to_f, row[:gain_pct].to_f, row[:temp_pct].to_f, status_rank || -1].to_json %>">
            <td class="px-4 py-3 font-medium text-slate-900">
              <%= link_to row[:sector].label, sector_detail_portfolios_path(sector_id: row[:sector].id, portfolio_ids: @selected_portfolio_ids, position_role: @position_role), class: "hover:text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-right text-slate-600">
              <%= link_to row[:asset_count], sector_detail_portfolios_path(sector_id: row[:sector].id, portfolio_ids: @selected_portfolio_ids, position_role: @position_role), class: "text-blue-600 hover:underline" %>
              <% if row[:watchlist_count].to_i > 0 %>
                <span class="ml-1 rounded bg-amber-50 px-1 text-[10px] font-medium text-amber-700" title="Watchlist (quantity 0, not owned)">+<%= row[:watchlist_count] %> watch</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right font-mono"><%= number_with_precision(row[:value], precision: 2) %></td>

            <%# Actual % with bar — coloured by RISK STATUS vs the guideline cap.
                Below the cap is safe (green), not a deficit to fill. %>
            <% if cap && cap > 0
                 bar_fill = [(actual_pct / cap * 100).round(1), 100].min
                 bar_hex = status_hex
               else
                 bar_fill = [actual_pct, 100].min
                 bar_hex = "#94a3b8"
               end %>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <div class="h-2 w-20 overflow-hidden rounded-full bg-slate-100">
                  <div class="h-2 rounded-full" style="width: <%= bar_fill %>%; background-color: <%= bar_hex %>;"></div>
                </div>
                <span class="w-12 text-right font-mono text-slate-700"><%= number_with_precision(actual_pct, precision: 1) %>%</span>
              </div>
            </td>

            <%# Overall % (all portfolios, ignores filter) %>
            <td class="px-4 py-3 text-right font-mono text-slate-500"><%= number_with_precision(row[:pct_of_sectored_overall], precision: 1) %>%</td>

            <%# Guideline Cap % (soft risk limit, not a target) %>
            <td class="px-4 py-3 text-right font-mono" title="Maximum preferred exposure for portfolio risk management. This is not a target allocation.">
              <% if cap %>
                <span class="text-slate-700"><%= number_with_precision(cap, precision: 1) %>%</span>
                <% if is_default_cap %><span class="ml-1 text-[10px] text-slate-400" title="Default guideline — edit to override">def</span><% end %>
              <% else %>
                <span class="text-slate-300">—</span>
              <% end %>
            </td>

            <%# Room to Cap = Guideline Cap − Actual. Positive = risk capacity
                remaining (NOT a buy signal); negative = over the cap. %>
            <td class="px-4 py-3 text-right font-mono" title="Remaining exposure capacity before the guideline cap. Positive room does not imply additional investment is required.">
              <% if room.nil? %>
                <span class="text-slate-300">—</span>
              <% elsif room < 0 %>
                <span class="text-red-600 font-medium"><%= number_with_precision(room.abs, precision: 1) %> pp Over Cap</span>
              <% else %>
                <span class="<%= status_text %>">+<%= number_with_precision(room, precision: 1) %> pp</span>
              <% end %>
            </td>

            <%# % of included %>
            <% included_pct = row[:pct_of_included].to_f
               included_bar_hex = included_pct > 10 ? "#ef4444" : "#10b981"
               included_text_class = included_pct > 10 ? "text-red-600" : "text-slate-700" %>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <div class="h-2 w-20 overflow-hidden rounded-full bg-slate-100">
                  <div class="h-2 rounded-full" style="width: <%= [included_pct, 100].min %>%; background-color: <%= included_bar_hex %>;"></div>
                </div>
                <span class="w-12 text-right font-mono <%= included_text_class %>"><%= number_with_precision(included_pct, precision: 1) %>%</span>
              </div>
            </td>

            <%# Gain/Loss % %>
            <% gain_pct = row[:gain_pct].to_f
               gain_color = gain_pct >= 0 ? "text-emerald-600" : "text-red-600" %>
            <td class="px-4 py-3 text-right font-mono">
              <span class="<%= gain_color %>">
                <%= gain_pct >= 0 ? "+" : "" %><%= number_with_precision(gain_pct, precision: 1) %>%
              </span>
            </td>

            <%# Base / Temporary split of the sector's direct-stock value %>
            <td class="px-4 py-3 text-right font-mono">
              <% if row[:base_pct] && row[:temp_pct] %>
                <span title="Base <%= number_with_precision(row[:base_value], precision: 2) %> · Temporary <%= number_with_precision(row[:temp_value], precision: 2) %>">
                  <span class="text-slate-600"><%= number_with_precision(row[:base_pct], precision: 1) %>%</span>
                  <span class="text-slate-400">/</span>
                  <span class="text-amber-600"><%= number_with_precision(row[:temp_pct], precision: 1) %>%</span>
                </span>
              <% else %>
                <span class="text-slate-400">—</span>
              <% end %>
            </td>

            <%# Risk status badge %>
            <td class="px-4 py-3 text-center">
              <% if status %>
                <span class="inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold <%= status == :safe ? 'bg-emerald-50 text-emerald-700' : status == :watch ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-600' %>"><%= status_label %></span>
              <% else %>
                <span class="text-slate-300">—</span>
              <% end %>
            </td>

            <%# Inline guideline-cap edit %>
            <td class="px-4 py-3 text-center">
              <button type="button"
                      onclick="document.getElementById('target-form-<%= row[:sector].id %>').classList.toggle('hidden')"
                      class="rounded p-1 text-slate-400 hover:text-blue-600"
                      title="Set guideline cap">✏️</button>
              <div id="target-form-<%= row[:sector].id %>" class="hidden mt-1">
                <% if target %>
                  <%= form_with url: sector_sector_target_path(row[:sector]), method: :patch, class: "flex items-center gap-1" do |f| %>
                    <input type="number" name="target_percentage" value="<%= target.target_percentage %>"
                           step="0.1" min="0.1" max="100"
                           class="w-20 rounded border border-slate-300 px-2 py-1 text-xs text-right"
                           required>
                    <span class="text-xs text-slate-500">%</span>
                    <button type="submit" class="rounded bg-blue-600 px-2 py-1 text-xs text-white hover:bg-blue-700">Save</button>
                  <% end %>
                  <%= button_to "✕", sector_sector_target_path(row[:sector]), method: :delete,
                        class: "mt-1 text-xs text-red-500 hover:underline" %>
                <% else %>
                  <%= form_with url: sector_sector_target_path(row[:sector]), method: :post, class: "flex items-center gap-1" do |f| %>
                    <input type="number" name="target_percentage"
                           step="0.1" min="0.1" max="100" placeholder="0.0"
                           class="w-20 rounded border border-slate-300 px-2 py-1 text-xs text-right"
                           required>
                    <span class="text-xs text-slate-500">%</span>
                    <button type="submit" class="rounded bg-blue-600 px-2 py-1 text-xs text-white hover:bg-blue-700">Set</button>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-slate-200 bg-slate-50 font-semibold">
        <tr>
          <td class="px-4 py-3">Total</td>
          <td class="px-4 py-3 text-right">
            <%= @sector_rows.sum { |r| r[:asset_count] } %>
            <% wl = @sector_rows.sum { |r| r[:watchlist_count].to_i } %>
            <% if wl > 0 %><span class="ml-1 rounded bg-amber-50 px-1 text-[10px] font-medium text-amber-700">+<%= wl %> watch</span><% end %>
          </td>
          <td class="px-4 py-3 text-right font-mono"><%= number_with_precision(@sectored_total, precision: 2) %></td>
          <td class="px-4 py-3 text-right font-mono">100.0%</td>
          <td class="px-4 py-3 text-right font-mono text-slate-500"><%= number_with_precision(@sector_rows.sum { |r| r[:pct_of_sectored_overall].to_f }, precision: 1) %>%</td>
          <td class="px-4 py-3 text-right font-mono text-slate-400" title="Guideline caps are independent risk limits and are not summed.">—</td>
          <td class="px-4 py-3 text-right font-mono text-slate-400">—</td>
          <td class="px-4 py-3 text-right font-mono">
            <%= @included_total.nonzero? ? number_with_precision((@sectored_total / @included_total) * 100, precision: 1) : "—" %>%
          </td>
          <% total_cost = @sector_rows.sum { |r| r[:cost_basis].to_f }
             total_gain = @sector_rows.sum { |r| r[:unrealised_gain].to_f }
             total_gain_pct = total_cost.nonzero? ? (total_gain / total_cost * 100) : 0
             total_gain_color = total_gain_pct >= 0 ? "text-emerald-600" : "text-red-600" %>
          <td class="px-4 py-3 text-right font-mono <%= total_gain_color %>">
            <%= total_gain_pct >= 0 ? "+" : "" %><%= number_with_precision(total_gain_pct, precision: 1) %>%
          </td>
          <td class="px-4 py-3 text-right font-mono text-slate-400">—</td>
          <td class="px-4 py-3 text-center text-slate-400">—</td>
          <td class="px-4 py-3"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <script>
    (function () {
      var tbody = document.getElementById("sector-tbody");
      var ths   = document.querySelectorAll("#sector-table thead th[data-col]");
      var sortCol = null, sortAsc = true;
      ths.forEach(function (th) {
        th.addEventListener("click", function () {
          var col  = parseInt(th.dataset.col, 10);
          var type = th.dataset.type;
          sortAsc  = (sortCol === col) ? !sortAsc : true;
          sortCol  = col;
          ths.forEach(function (h) {
            h.querySelector(".sort-icon").textContent = "↕";
            h.querySelector(".sort-icon").className = "sort-icon text-slate-300";
          });
          th.querySelector(".sort-icon").textContent = sortAsc ? "↑" : "↓";
          th.querySelector(".sort-icon").className = "sort-icon text-slate-700";
          var rows = Array.from(tbody.querySelectorAll("tr"));
          rows.sort(function (a, b) {
            var av = JSON.parse(a.dataset.vals)[col];
            var bv = JSON.parse(b.dataset.vals)[col];
            if (type === "number") { av = parseFloat(av) || 0; bv = parseFloat(bv) || 0; }
            else { av = String(av).toLowerCase(); bv = String(bv).toLowerCase(); }
            return av < bv ? (sortAsc ? -1 : 1) : av > bv ? (sortAsc ? 1 : -1) : 0;
          });
          rows.forEach(function (r) { tbody.appendChild(r); });
        });
      });
    })();
  </script>
<% end %>
