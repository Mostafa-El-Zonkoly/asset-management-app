<% content_for :title, "Sector analysis" %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900">Sector analysis — all portfolios</h1>
    <p class="mt-1 text-sm text-slate-600">
      Direct stock holdings with a sector assigned, aggregated across all portfolios.
      <strong>Actual %</strong> is each sector's share of total sectored assets.
      <strong>Target %</strong> is your desired allocation — click the pencil to set or update it.
      Click any column header to sort.
    </p>
  </div>
  <%= link_to "By sector + speciality", sector_speciality_analysis_portfolios_path, class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
</div>

<% if @reporting_currency %>
  <p class="mt-4 text-sm text-slate-600">Figures in reporting currency <span class="font-medium"><%= @reporting_currency.code %></span>.</p>
<% end %>

<% if @missing_fx_codes&.any? %>
  <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
    Missing FX into reporting currency for: <strong><%= @missing_fx_codes.join(", ") %></strong>. Totals may be incomplete.
  </div>
<% end %>

<div class="mt-6 grid gap-4 sm:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Total sectored value</p>
    <p class="mt-1 text-xl font-semibold"><%= number_with_precision(@sectored_total, precision: 2) %> <%= @reporting_currency&.code %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Included portfolios total</p>
    <p class="mt-1 text-xl font-semibold"><%= number_with_precision(@included_total, precision: 2) %> <%= @reporting_currency&.code %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Sectors</p>
    <p class="mt-1 text-xl font-semibold"><%= @sector_rows.size %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Total target %</p>
    <p class="mt-1 text-xl font-semibold <%= @total_target_pct > 100 ? 'text-red-600' : (@total_target_pct == 100 ? 'text-emerald-600' : 'text-slate-900') %>">
      <%= number_with_precision(@total_target_pct, precision: 1) %>%
    </p>
  </div>
</div>

<% if @sector_rows.blank? %>
  <p class="mt-8 text-slate-500">No direct stock holdings with a sector assigned were found.</p>
<% else %>
  <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table id="sector-table" class="min-w-full text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="cursor-pointer select-none px-4 py-3 text-left hover:bg-slate-100" data-col="0" data-type="string">Sector <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="1" data-type="number">Holdings <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="2" data-type="number">Value (<%= @reporting_currency&.code %>) <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="3" data-type="number">Actual % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="4" data-type="number">Target % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="5" data-type="number">Deviation (pp) <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="6" data-type="number">% of included <span class="sort-icon text-slate-300">↕</span></th>
          <th class="cursor-pointer select-none px-4 py-3 text-right hover:bg-slate-100" data-col="7" data-type="number">Gain/Loss % <span class="sort-icon text-slate-300">↕</span></th>
          <th class="px-4 py-3 text-center">Target</th>
        </tr>
      </thead>
      <tbody id="sector-tbody" class="divide-y divide-slate-100">
        <% @sector_rows.each do |row| %>
          <% target = @targets_by_sector_id[row[:sector].id] %>
          <% actual_pct = row[:pct_of_sectored].to_f %>
          <% target_pct = target&.target_percentage&.to_f %>
          <% deviation = target_pct ? (actual_pct - target_pct).round(2) : nil %>
          <tr class="hover:bg-slate-50"
              data-vals="<%= [row[:sector].label, row[:asset_count], row[:value].to_f, actual_pct, target_pct || -99999, deviation || -99999, row[:pct_of_included].to_f, row[:gain_pct].to_f].to_json %>">
            <td class="px-4 py-3 font-medium text-slate-900">
              <%= link_to row[:sector].label, sector_detail_portfolios_path(sector_id: row[:sector].id), class: "hover:text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-right text-slate-600">
              <%= link_to row[:asset_count], sector_detail_portfolios_path(sector_id: row[:sector].id), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-right font-mono"><%= number_with_precision(row[:value], precision: 2) %></td>

            <%# Actual % with bar %>
            <% if target_pct && target_pct > 0
                 deviation_pct = actual_pct - target_pct
                 ratio = actual_pct / target_pct
                 if ratio > 1.1
                   bar_fill = 100
                   bar_hex = "#ef4444"
                 elsif ratio >= 0.9
                   bar_fill = (actual_pct / target_pct * 100).round(1)
                   bar_hex = "#3b82f6"
                 else
                   bar_fill = (actual_pct / target_pct * 100).round(1)
                   bar_hex = "#facc15"
                 end
               else
                 bar_fill = [actual_pct, 100].min
                 bar_hex = "#3b82f6"
               end %>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <div class="h-2 w-20 overflow-hidden rounded-full bg-slate-100">
                  <div class="h-2 rounded-full" style="width: <%= bar_fill %>%; background-color: <%= bar_hex %>;"></div>
                </div>
                <span class="w-12 text-right font-mono text-slate-700"><%= number_with_precision(actual_pct, precision: 1) %>%</span>
              </div>
            </td>

            <%# Target % %>
            <td class="px-4 py-3 text-right font-mono">
              <% if target_pct %>
                <span class="text-slate-700"><%= number_with_precision(target_pct, precision: 1) %>%</span>
              <% else %>
                <span class="text-slate-300">—</span>
              <% end %>
            </td>

            <%# Deviation %>
            <td class="px-4 py-3 text-right font-mono">
              <% if deviation %>
                <% dev_class = deviation > 0.5 ? "text-emerald-600" : deviation < -0.5 ? "text-red-600" : "text-slate-500" %>
                <span class="<%= dev_class %>">
                  <%= deviation > 0 ? "+" : "" %><%= number_with_precision(deviation, precision: 1) %>
                </span>
              <% else %>
                <span class="text-slate-300">—</span>
              <% end %>
            </td>

            <%# % of included %>
            <% included_pct = row[:pct_of_included].to_f
               included_bar_hex = included_pct > 10 ? "#ef4444" : "#10b981"
               included_text_class = included_pct > 10 ? "text-red-600" : "text-slate-700" %>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <div class="h-2 w-20 overflow-hidden rounded-full bg-slate-100">
                  <div class="h-2 rounded-full" style="width: <%= [included_pct, 100].min %>%; background-color: <%= included_bar_hex %>;"></div>
                </div>
                <span class="w-12 text-right font-mono <%= included_text_class %>"><%= number_with_precision(included_pct, precision: 1) %>%</span>
              </div>
            </td>

            <%# Gain/Loss % %>
            <% gain_pct = row[:gain_pct].to_f
               gain_color = gain_pct >= 0 ? "text-emerald-600" : "text-red-600" %>
            <td class="px-4 py-3 text-right font-mono">
              <span class="<%= gain_color %>">
                <%= gain_pct >= 0 ? "+" : "" %><%= number_with_precision(gain_pct, precision: 1) %>%
              </span>
            </td>

            <%# Inline target edit %>
            <td class="px-4 py-3 text-center">
              <button type="button"
                      onclick="document.getElementById('target-form-<%= row[:sector].id %>').classList.toggle('hidden')"
                      class="rounded p-1 text-slate-400 hover:text-blue-600"
                      title="Set target">✏️</button>
              <div id="target-form-<%= row[:sector].id %>" class="hidden mt-1">
                <% if target %>
                  <%= form_with url: sector_sector_target_path(row[:sector]), method: :patch, class: "flex items-center gap-1" do |f| %>
                    <input type="number" name="target_percentage" value="<%= target.target_percentage %>"
                           step="0.1" min="0.1" max="100"
                           class="w-20 rounded border border-slate-300 px-2 py-1 text-xs text-right"
                           required>
                    <span class="text-xs text-slate-500">%</span>
                    <button type="submit" class="rounded bg-blue-600 px-2 py-1 text-xs text-white hover:bg-blue-700">Save</button>
                  <% end %>
                  <%= button_to "✕", sector_sector_target_path(row[:sector]), method: :delete,
                        class: "mt-1 text-xs text-red-500 hover:underline" %>
                <% else %>
                  <%= form_with url: sector_sector_target_path(row[:sector]), method: :post, class: "flex items-center gap-1" do |f| %>
                    <input type="number" name="target_percentage"
                           step="0.1" min="0.1" max="100" placeholder="0.0"
                           class="w-20 rounded border border-slate-300 px-2 py-1 text-xs text-right"
                           required>
                    <span class="text-xs text-slate-500">%</span>
                    <button type="submit" class="rounded bg-blue-600 px-2 py-1 text-xs text-white hover:bg-blue-700">Set</button>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-slate-200 bg-slate-50 font-semibold">
        <tr>
          <td class="px-4 py-3">Total</td>
          <td class="px-4 py-3 text-right"><%= @sector_rows.sum { |r| r[:asset_count] } %></td>
          <td class="px-4 py-3 text-right font-mono"><%= number_with_precision(@sectored_total, precision: 2) %></td>
          <td class="px-4 py-3 text-right font-mono">100.0%</td>
          <td class="px-4 py-3 text-right font-mono <%= @total_target_pct > 100 ? 'text-red-600' : '' %>">
            <%= number_with_precision(@total_target_pct, precision: 1) %>%
          </td>
          <td class="px-4 py-3"></td>
          <td class="px-4 py-3 text-right font-mono">
            <%= @included_total.nonzero? ? number_with_precision((@sectored_total / @included_total) * 100, precision: 1) : "—" %>%
          </td>
          <% total_cost = @sector_rows.sum { |r| r[:cost_basis].to_f }
             total_gain = @sector_rows.sum { |r| r[:unrealised_gain].to_f }
             total_gain_pct = total_cost.nonzero? ? (total_gain / total_cost * 100) : 0
             total_gain_color = total_gain_pct >= 0 ? "text-emerald-600" : "text-red-600" %>
          <td class="px-4 py-3 text-right font-mono <%= total_gain_color %>">
            <%= total_gain_pct >= 0 ? "+" : "" %><%= number_with_precision(total_gain_pct, precision: 1) %>%
          </td>
          <td class="px-4 py-3"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <script>
    (function () {
      var tbody = document.getElementById("sector-tbody");
      var ths   = document.querySelectorAll("#sector-table thead th[data-col]");
      var sortCol = null, sortAsc = true;
      ths.forEach(function (th) {
        th.addEventListener("click", function () {
          var col  = parseInt(th.dataset.col, 10);
          var type = th.dataset.type;
          sortAsc  = (sortCol === col) ? !sortAsc : true;
          sortCol  = col;
          ths.forEach(function (h) {
            h.querySelector(".sort-icon").textContent = "↕";
            h.querySelector(".sort-icon").className = "sort-icon text-slate-300";
          });
          th.querySelector(".sort-icon").textContent = sortAsc ? "↑" : "↓";
          th.querySelector(".sort-icon").className = "sort-icon text-slate-700";
          var rows = Array.from(tbody.querySelectorAll("tr"));
          rows.sort(function (a, b) {
            var av = JSON.parse(a.dataset.vals)[col];
            var bv = JSON.parse(b.dataset.vals)[col];
            if (type === "number") { av = parseFloat(av) || 0; bv = parseFloat(bv) || 0; }
            else { av = String(av).toLowerCase(); bv = String(bv).toLowerCase(); }
            return av < bv ? (sortAsc ? -1 : 1) : av > bv ? (sortAsc ? 1 : -1) : 0;
          });
          rows.forEach(function (r) { tbody.appendChild(r); });
        });
      });
    })();
  </script>
<% end %>
