<% content_for :title, "Sector / speciality analysis" %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900">Sector &amp; speciality analysis — <%= @selected_portfolio_ids.any? ? "selected portfolios" : "all portfolios" %></h1>
    <p class="mt-1 text-sm text-slate-600">
      Direct stock holdings with a sector assigned, broken down by speciality within each sector.
      Click a sector header to collapse / expand it. Click any column header inside a sector to sort.
    </p>
  </div>
  <div class="flex gap-2">
    <button id="expand-all" class="rounded-md border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Expand all</button>
    <button id="collapse-all" class="rounded-md border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Collapse all</button>
    <%= link_to "By sector only", sector_analysis_portfolios_path(portfolio_ids: @selected_portfolio_ids), class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
</div>

<%= render "portfolios/portfolio_filter", url: sector_speciality_analysis_portfolios_path, portfolios: @portfolios, selected_ids: @selected_portfolio_ids %>

<% if @reporting_currency %>
  <p class="mt-4 text-sm text-slate-600">Figures in reporting currency <span class="font-medium"><%= @reporting_currency.code %></span>.</p>
<% end %>

<% if @missing_fx_codes&.any? %>
  <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
    Missing FX into reporting currency for: <strong><%= @missing_fx_codes.join(", ") %></strong>. Totals may be incomplete.
  </div>
<% end %>

<div class="mt-6 grid gap-4 sm:grid-cols-3">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Total sectored value</p>
    <p class="mt-1 text-xl font-semibold"><%= number_with_precision(@sectored_total, precision: 2) %> <%= @reporting_currency&.code %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500"><%= @selected_portfolio_ids.any? ? "Selected portfolios total" : "Included portfolios total" %></p>
    <p class="mt-1 text-xl font-semibold"><%= number_with_precision(@included_total, precision: 2) %> <%= @reporting_currency&.code %></p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">Sectors</p>
    <p class="mt-1 text-xl font-semibold"><%= @sector_groups.size %></p>
  </div>
</div>

<% if @sector_groups.blank? %>
  <p class="mt-8 text-slate-500">No direct stock holdings with a sector assigned were found.</p>
<% else %>
  <div class="mt-8 space-y-4" id="sector-groups">
    <% @sector_groups.each_with_index do |group, gi| %>
      <% tbl_id = "spec-tbl-#{gi}" %>
      <% tbody_id = "spec-tbody-#{gi}" %>
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm sector-group">

        <%# --- Collapsible header --- %>
        <button type="button"
                class="sector-toggle flex w-full flex-wrap items-center justify-between gap-2 border-b border-slate-200 bg-slate-50 px-4 py-3 text-left hover:bg-slate-100"
                aria-expanded="true">
          <div class="flex items-center gap-3">
            <span class="text-slate-400 transition-transform duration-150 toggle-chevron">▾</span>
            <%= link_to group[:sector].label, sector_detail_portfolios_path(sector_id: group[:sector].id, portfolio_ids: @selected_portfolio_ids),
                  class: "font-semibold text-slate-900 hover:text-blue-600 hover:underline",
                  onclick: "event.stopPropagation();" %>
            <span class="text-sm text-slate-500">
              <%= number_with_precision(group[:sector_total], precision: 2) %> <%= @reporting_currency&.code %>
            </span>
          </div>
          <div class="flex gap-4 text-sm text-slate-600">
            <span>
              <span class="text-xs uppercase tracking-wide text-slate-400">% of sectored</span>
              <span class="ml-1 font-mono font-medium"><%= number_with_precision(group[:pct_of_sectored], precision: 1) %>%</span>
            </span>
            <span>
              <span class="text-xs uppercase tracking-wide text-slate-400">% overall</span>
              <span class="ml-1 font-mono font-medium text-slate-500"><%= number_with_precision(group[:pct_of_sectored_overall], precision: 1) %>%</span>
            </span>
            <span>
              <span class="text-xs uppercase tracking-wide text-slate-400">% of included</span>
              <span class="ml-1 font-mono font-medium"><%= number_with_precision(group[:pct_of_included], precision: 1) %>%</span>
            </span>
          </div>
        </button>

        <%# --- Collapsible body --- %>
        <div class="sector-body overflow-x-auto">
          <table id="<%= tbl_id %>" class="min-w-full text-sm">
            <thead class="text-xs uppercase tracking-wide text-slate-400">
              <tr>
                <th class="cursor-pointer select-none pl-8 px-4 py-2 text-left hover:bg-slate-50" data-col="0" data-type="string">Speciality <span class="sort-icon text-slate-300">↕</span></th>
                <th class="cursor-pointer select-none px-4 py-2 text-right hover:bg-slate-50" data-col="1" data-type="number">Assets <span class="sort-icon text-slate-300">↕</span></th>
                <th class="cursor-pointer select-none px-4 py-2 text-right hover:bg-slate-50" data-col="2" data-type="number">Value (<%= @reporting_currency&.code %>) <span class="sort-icon text-slate-300">↕</span></th>
                <th class="cursor-pointer select-none px-4 py-2 text-right hover:bg-slate-50" data-col="3" data-type="number">% of sector <span class="sort-icon text-slate-300">↕</span></th>
                <th class="cursor-pointer select-none px-4 py-2 text-right hover:bg-slate-50" data-col="4" data-type="number">% of sectored <span class="sort-icon text-slate-300">↕</span></th>
                <th class="cursor-pointer select-none px-4 py-2 text-right hover:bg-slate-50" data-col="5" data-type="number">% overall <span class="sort-icon text-slate-300">↕</span></th>
                <th class="cursor-pointer select-none px-4 py-2 text-right hover:bg-slate-50" data-col="6" data-type="number">% of included <span class="sort-icon text-slate-300">↕</span></th>
              </tr>
            </thead>
            <tbody id="<%= tbody_id %>" class="divide-y divide-slate-100">
              <% group[:speciality_rows].each do |row| %>
                <tr class="hover:bg-slate-50"
                    data-vals="<%= [row[:speciality]&.label || '', row[:asset_count], row[:value].to_f, row[:pct_of_sector].to_f, row[:pct_of_sectored].to_f, row[:pct_of_sectored_overall].to_f, row[:pct_of_included].to_f].to_json %>">
                  <td class="pl-8 px-4 py-2 text-slate-700">
                    <% if row[:speciality] %>
                      <%= link_to row[:speciality].label, sector_speciality_detail_portfolios_path(sector_id: group[:sector].id, speciality_id: row[:speciality].id, portfolio_ids: @selected_portfolio_ids), class: "hover:text-blue-600 hover:underline" %>
                    <% else %>
                      <%= link_to "— no speciality —", sector_detail_portfolios_path(sector_id: group[:sector].id, portfolio_ids: @selected_portfolio_ids), class: "text-slate-400 hover:text-blue-600 hover:underline" %>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right text-slate-500">
                    <% if row[:speciality] %>
                      <%= link_to row[:asset_count], sector_speciality_detail_portfolios_path(sector_id: group[:sector].id, speciality_id: row[:speciality].id, portfolio_ids: @selected_portfolio_ids), class: "text-blue-600 hover:underline" %>
                    <% else %>
                      <%= link_to row[:asset_count], sector_detail_portfolios_path(sector_id: group[:sector].id, portfolio_ids: @selected_portfolio_ids), class: "text-blue-600 hover:underline" %>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right font-mono"><%= number_with_precision(row[:value], precision: 2) %></td>
                  <td class="px-4 py-2 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <div class="h-2 w-16 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-2 rounded-full bg-violet-400" style="width: <%= [row[:pct_of_sector].to_f, 100].min %>%"></div>
                      </div>
                      <span class="w-12 text-right font-mono text-slate-700"><%= number_with_precision(row[:pct_of_sector], precision: 1) %>%</span>
                    </div>
                  </td>
                  <td class="px-4 py-2 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <div class="h-2 w-16 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-2 rounded-full bg-blue-500" style="width: <%= [row[:pct_of_sectored].to_f, 100].min %>%"></div>
                      </div>
                      <span class="w-12 text-right font-mono text-slate-700"><%= number_with_precision(row[:pct_of_sectored], precision: 1) %>%</span>
                    </div>
                  </td>
                  <td class="px-4 py-2 text-right font-mono text-slate-500"><%= number_with_precision(row[:pct_of_sectored_overall], precision: 1) %>%</td>
                  <td class="px-4 py-2 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <div class="h-2 w-16 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-2 rounded-full bg-emerald-500" style="width: <%= [row[:pct_of_included].to_f, 100].min %>%"></div>
                      </div>
                      <span class="w-12 text-right font-mono text-slate-700"><%= number_with_precision(row[:pct_of_included], precision: 1) %>%</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="border-t border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
              <tr>
                <td class="pl-8 px-4 py-2">Sector total</td>
                <td class="px-4 py-2 text-right"><%= group[:speciality_rows].sum { |r| r[:asset_count] } %></td>
                <td class="px-4 py-2 text-right font-mono"><%= number_with_precision(group[:sector_total], precision: 2) %></td>
                <td class="px-4 py-2 text-right font-mono">100.0%</td>
                <td class="px-4 py-2 text-right font-mono"><%= number_with_precision(group[:pct_of_sectored], precision: 1) %>%</td>
                <td class="px-4 py-2 text-right font-mono text-slate-500"><%= number_with_precision(group[:pct_of_sectored_overall], precision: 1) %>%</td>
                <td class="px-4 py-2 text-right font-mono"><%= number_with_precision(group[:pct_of_included], precision: 1) %>%</td>
              </tr>
            </tfoot>
          </table>
        </div>

      </div>
    <% end %>
  </div>

  <script>
    (function () {
      // --- Collapse / expand ---
      function setExpanded(btn, open) {
        var body    = btn.closest(".sector-group").querySelector(".sector-body");
        var chevron = btn.querySelector(".toggle-chevron");
        body.style.display    = open ? "" : "none";
        chevron.style.transform = open ? "" : "rotate(-90deg)";
        btn.setAttribute("aria-expanded", open);
      }

      document.querySelectorAll(".sector-toggle").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var open = btn.getAttribute("aria-expanded") === "true";
          setExpanded(btn, !open);
        });
      });

      document.getElementById("collapse-all").addEventListener("click", function () {
        document.querySelectorAll(".sector-toggle").forEach(function (btn) { setExpanded(btn, false); });
      });
      document.getElementById("expand-all").addEventListener("click", function () {
        document.querySelectorAll(".sector-toggle").forEach(function (btn) { setExpanded(btn, true); });
      });

      // --- Per-table sorting ---
      document.querySelectorAll("[id^='spec-tbl-']").forEach(function (tbl) {
        var tbody   = tbl.querySelector("tbody");
        var ths     = tbl.querySelectorAll("thead th");
        var sortCol = null, sortAsc = true;

        ths.forEach(function (th) {
          th.addEventListener("click", function () {
            var col  = parseInt(th.dataset.col, 10);
            var type = th.dataset.type;
            sortAsc  = (sortCol === col) ? !sortAsc : true;
            sortCol  = col;

            ths.forEach(function (h) {
              h.querySelector(".sort-icon").textContent = "↕";
              h.querySelector(".sort-icon").className   = "sort-icon text-slate-300";
            });
            th.querySelector(".sort-icon").textContent = sortAsc ? "↑" : "↓";
            th.querySelector(".sort-icon").className   = "sort-icon text-slate-700";

            var rows = Array.from(tbody.querySelectorAll("tr"));
            rows.sort(function (a, b) {
              var av = JSON.parse(a.dataset.vals)[col];
              var bv = JSON.parse(b.dataset.vals)[col];
              if (type === "number") { av = parseFloat(av) || 0; bv = parseFloat(bv) || 0; }
              else { av = String(av).toLowerCase(); bv = String(bv).toLowerCase(); }
              return av < bv ? (sortAsc ? -1 : 1) : av > bv ? (sortAsc ? 1 : -1) : 0;
            });
            rows.forEach(function (r) { tbody.appendChild(r); });
          });
        });
      });
    })();
  </script>
<% end %>
