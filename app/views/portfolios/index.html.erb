<% content_for :title, "Portfolios" %>
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold">Portfolios</h1>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Funding plan", funding_plan_portfolios_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50" %>
    <%= link_to "All statistics", statistics_portfolios_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50" %>
    <%= link_to "New portfolio", new_portfolio_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
  </div>
</div>

<% if @master && @summaries_by_portfolio.any? %>
  <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-medium text-slate-900">Master portfolio <span class="text-xs font-normal text-slate-400">(internal transfers netted out)</span></h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <%= link_to "Transfer cash", new_cash_move_path, class: "rounded-md bg-blue-600 px-3 py-1.5 font-medium text-white hover:bg-blue-700" %>
        <%= link_to "Export report", portfolio_report_path(format: :pdf), class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-800 hover:bg-slate-50" %>
      </div>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <div class="rounded-lg border border-slate-200 p-3"><p class="text-[11px] uppercase text-slate-500">Master NAV</p><p class="mt-1 font-semibold tabular-nums"><%= number_with_precision(@master.nav, precision: 0) %></p></div>
      <div class="rounded-lg border border-slate-200 p-3"><p class="text-[11px] uppercase text-slate-500">Equity value</p><p class="mt-1 font-semibold tabular-nums"><%= number_with_precision(@master.holdings_value, precision: 0) %></p></div>
      <div class="rounded-lg border border-slate-200 p-3"><p class="text-[11px] uppercase text-slate-500">Cash</p><p class="mt-1 font-semibold tabular-nums"><%= number_with_precision(@master.cash, precision: 0) %></p></div>
      <div class="rounded-lg border border-slate-200 p-3"><p class="text-[11px] uppercase text-slate-500">Ext. contributions</p><p class="mt-1 font-semibold tabular-nums text-emerald-700">+<%= number_with_precision(@master.external_contributions, precision: 0) %></p></div>
      <div class="rounded-lg border border-slate-200 p-3"><p class="text-[11px] uppercase text-slate-500">Ext. withdrawals</p><p class="mt-1 font-semibold tabular-nums text-red-600">−<%= number_with_precision(@master.external_withdrawals, precision: 0) %></p></div>
      <div class="rounded-lg border border-slate-200 p-3"><p class="text-[11px] uppercase text-slate-500">Internal transfers</p><p class="mt-1 font-semibold tabular-nums text-slate-500"><%= number_with_precision(@master.internal_transfers, precision: 0) %></p></div>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-slate-50/60 p-3"><p class="text-[11px] uppercase text-slate-500">Total wealth</p><p class="mt-1 text-lg font-semibold tabular-nums"><%= number_with_precision(@master.total_wealth, precision: 0) %></p></div>
      <div class="rounded-lg border border-slate-200 bg-slate-50/60 p-3"><p class="text-[11px] uppercase text-slate-500">Net profit</p><p class="mt-1 text-lg font-semibold tabular-nums"><span class="<%= pnl_class_for(@master.net_profit) %>"><%= number_with_precision(@master.net_profit, precision: 0) %></span></p></div>
      <div class="rounded-lg border border-slate-200 bg-slate-50/60 p-3"><p class="text-[11px] uppercase text-slate-500">Simple ROI</p><p class="mt-1 text-lg font-semibold tabular-nums"><% if @master.simple_roi %><span class="<%= pnl_class_for(@master.simple_roi) %>"><%= format_upside(@master.simple_roi) %></span><% else %><span class="text-slate-300">N/A</span><% end %></p></div>
    </div>
  </div>
<% end %>

<% if @reporting_currency %>
  <p class="mt-4 text-sm text-slate-600">Values use each asset’s currency for prices and costs, then convert to the reporting currency <strong><%= @reporting_currency.code %></strong> using <%= link_to "exchange rates", settings_exchange_rates_path, class: "text-blue-600 underline" %>.</p>
<% end %>

<% if @missing_fx_codes&.any? %>
  <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
    Missing FX into reporting currency for: <strong><%= @missing_fx_codes.join(", ") %></strong>. Totals may be wrong until you add rates (1:1 is assumed when no rate exists).
  </div>
<% end %>

<% if @summaries_by_portfolio.empty? %>
  <p class="mt-6 text-slate-600">No portfolios yet. <%= link_to "Create one", new_portfolio_path, class: "text-blue-600 underline" %>.</p>
  <% if @wallet_cash_reporting.to_d.nonzero? || @free_cash_metrics[:target_pct].present? %>
    <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50/40 p-4 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="font-medium text-slate-900">Free cash (all wallets)</h2>
        <%= link_to "Edit target", edit_settings_free_cash_target_path, class: "rounded-md border border-emerald-300 bg-white px-3 py-1.5 text-sm text-emerald-900 hover:bg-emerald-50" %>
      </div>
      <div class="mt-3">
        <%= render "free_cash_target_readout", metrics: @free_cash_metrics, reporting_currency: @reporting_currency %>
      </div>
    </div>
  <% end %>
<% else %>
<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
  <table data-controller="sortable-table" class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase text-slate-500">
      <tr>
        <th class="px-4 py-2">Portfolio</th>
        <th class="px-4 py-2 text-right">Total value</th>
        <th class="px-4 py-2 text-right">% combined</th>
        <th class="px-4 py-2 text-right">Cost</th>
        <th class="px-4 py-2 text-right">Unrealised</th>
        <th class="px-4 py-2 text-right">Realised</th>
        <th class="px-4 py-2 text-right">Total gain</th>
        <th class="px-4 py-2 text-right" title="Base % / Temporary % of direct-equity value">Base / Temp</th>
      </tr>
    </thead>
    <tbody>
      <% @summaries_by_portfolio.each do |row| %>
        <% p = row[:portfolio] %>
        <% s = row[:stats] %>
        <% share_pct = if p.active && p.include_in_combined_percent && @wealth_denominator_for_percent.positive?
          ((s[:total_value].to_d / @wealth_denominator_for_percent) * 100)
        end %>
        <tr class="border-t border-slate-100 <%= "opacity-60" unless p.active %>">
          <td class="px-4 py-2 font-medium">
            <%= link_to p.name, p, class: "text-blue-600 hover:underline" %>
            <% unless p.active %>
              <span class="ml-1 rounded bg-red-100 px-1.5 py-0.5 text-xs font-normal text-red-700">Disabled</span>
            <% end %>
            <%= button_to (p.active ? "Disable" : "Enable"), toggle_active_portfolio_path(p), method: :patch, class: "ml-2 inline rounded border border-slate-300 px-1.5 py-0.5 text-[10px] font-normal text-slate-600 hover:bg-slate-50" %>
            <% unless p.include_in_combined_percent %>
              <span class="ml-1 rounded bg-slate-200 px-1.5 py-0.5 text-xs font-normal text-slate-700" title="Excluded from combined % denominator">off</span>
            <% end %>
          </td>
          <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(s[:total_value], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-700">
            <% if share_pct.nil? %>
              <span class="text-slate-400">—</span>
            <% else %>
              <%= number_with_precision(share_pct, precision: 2) %>%
            <% end %>
          </td>
          <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(s[:total_cost], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(s[:unrealised_gain], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(s[:realised_gain], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(s[:total_gain], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums">
            <% if s[:base_pct] && s[:temp_pct] %>
              <span title="Base <%= number_with_precision(s[:base_value], precision: 2) %> · Temporary <%= number_with_precision(s[:temp_value], precision: 2) %>">
                <span class="text-slate-600"><%= number_with_precision(s[:base_pct], precision: 1) %>%</span>
                <span class="text-slate-400">/</span>
                <span class="text-amber-600"><%= number_with_precision(s[:temp_pct], precision: 1) %>%</span>
              </span>
            <% else %>
              <span class="text-slate-400">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @summaries_by_portfolio.any? && @wealth_denominator_for_percent.positive? %>
        <% wshare = (@wallet_cash_reporting.to_d / @wealth_denominator_for_percent) * 100 %>
        <tr class="border-t border-slate-100 bg-emerald-50/40">
          <td class="px-4 py-2 font-medium text-slate-800">
            <%= link_to "Wallets (free cash)", wallets_path, class: "text-blue-600 hover:underline" %>
            <span class="ml-1 text-xs font-normal text-slate-600">(<%= link_to "target", edit_settings_free_cash_target_path, class: "text-blue-600 hover:underline" %>)</span>
          </td>
          <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(@wallet_cash_reporting, precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-700"><%= number_with_precision(wshare, precision: 2) %>%</td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-400">—</td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-400">—</td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-400">—</td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-400">—</td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-400">—</td>
        </tr>
      <% end %>
      <% if @summaries_by_portfolio.any? %>
        <% o = @overall_stats %>
        <% total_base = @summaries_by_portfolio.sum { |r| r[:stats][:base_value].to_d } %>
        <% total_temp = @summaries_by_portfolio.sum { |r| r[:stats][:temp_value].to_d } %>
        <% total_direct = total_base + total_temp %>
        <tr class="border-t-2 border-slate-200 bg-slate-50 font-medium">
          <td class="px-4 py-2">All portfolios</td>
          <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(o[:total_value], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-500">—</td>
          <td class="px-4 py-2 text-right tabular-nums"><%= number_with_precision(o[:total_cost], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(o[:unrealised_gain], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(o[:realised_gain], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums"><%= format_pnl_value(o[:total_gain], precision: 2) %></td>
          <td class="px-4 py-2 text-right tabular-nums">
            <% if total_direct.nonzero? %>
              <span title="Base <%= number_with_precision(total_base, precision: 2) %> · Temporary <%= number_with_precision(total_temp, precision: 2) %>">
                <span class="text-slate-600"><%= number_with_precision((total_base / total_direct) * 100, precision: 1) %>%</span>
                <span class="text-slate-400">/</span>
                <span class="text-amber-600"><%= number_with_precision((total_temp / total_direct) * 100, precision: 1) %>%</span>
              </span>
            <% else %>
              <span class="text-slate-400">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="border-t border-slate-100 px-4 py-2 text-xs text-slate-500">
    <% if @reporting_currency %>All columns in <%= @reporting_currency.code %>. <% end %>
    <span class="font-medium text-slate-700">% combined</span> uses denominator <strong>investments (included portfolios) + all wallet balances</strong> = <%= number_with_precision(@wealth_denominator_for_percent, precision: 2) %><% if @reporting_currency %> <%= @reporting_currency.code %><% end %> (invested <%= number_with_precision(@invested_included_total, precision: 2) %> + wallets <%= number_with_precision(@wallet_cash_reporting, precision: 2) %>). Rows marked <span class="rounded bg-slate-200 px-1">off</span> are excluded from the invested part only. The “All portfolios” row sums every portfolio’s investments (not wallets). Set a <%= link_to "free cash target", edit_settings_free_cash_target_path, class: "text-blue-600 underline" %> under Settings.
  </p>
</div>
  <% if @wallet_cash_reporting.to_d.nonzero? || @free_cash_metrics[:target_pct].present? %>
    <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50/40 p-4 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="font-medium text-slate-900">Free cash (all wallets)</h2>
        <%= link_to "Edit target", edit_settings_free_cash_target_path, class: "rounded-md border border-emerald-300 bg-white px-3 py-1.5 text-sm text-emerald-900 hover:bg-emerald-50" %>
      </div>
      <div class="mt-3">
        <%= render "free_cash_target_readout", metrics: @free_cash_metrics, reporting_currency: @reporting_currency %>
      </div>
    </div>
  <% end %>
<% end %>
