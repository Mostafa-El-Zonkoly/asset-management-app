<div class="mx-auto max-w-lg mt-16">
  <h1 class="text-2xl font-semibold text-slate-800 mb-2">Restore Database</h1>
  <p class="text-sm text-slate-500 mb-6">
    Upload a <code>.dump</code> file exported from this app.
    <strong class="text-red-600">This will overwrite the current database.</strong>
  </p>

  <%= form_with url: restore_backup_path, multipart: true do |f| %>
    <div class="rounded-lg border-2 border-dashed border-slate-300 bg-white p-8 text-center">
      <%= f.file_field :dump_file, accept: ".dump",
            class: "block w-full text-sm text-slate-600 file:mr-4 file:rounded-md file:border-0 file:bg-blue-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-blue-700 hover:file:bg-blue-100" %>
    </div>

    <div class="mt-4 flex items-center gap-3">
      <%= f.submit "⬆ Restore",
            class: "rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 cursor-pointer",
            data: { turbo_confirm: "This will overwrite the current database. Are you sure?" } %>
      <%= link_to "Cancel", root_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
    </div>
  <% end %>
</div>
