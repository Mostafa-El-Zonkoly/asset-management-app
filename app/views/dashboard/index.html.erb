<% content_for :title, "Dashboard" %>
<div class="space-y-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>
    <% if @portfolios.any? %>
      <%= form_with url: root_path, method: :get, class: "flex items-center gap-2", data: { turbo_frame: "_top" } do %>
        <label class="text-sm font-medium text-slate-900">Portfolio</label>
        <%= select_tag :portfolio_id,
            options_from_collection_for_select(@portfolios, :id, :name, @portfolio&.id),
            class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm",
            onchange: "this.form.submit()" %>
      <% end %>
    <% end %>
  </div>

  <% if @portfolios.any? && @overall_stats %>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="font-medium text-slate-900">All portfolios</h2>
        <% if @reporting_currency %>
          <span class="text-xs text-slate-500">Totals in <%= @reporting_currency.code %> · <%= link_to "FX rates", settings_exchange_rates_path, class: "text-blue-600 underline" %></span>
        <% end %>
      </div>
      <% if @missing_fx_codes&.any? %>
        <p class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
          Add exchange rates for: <strong><%= @missing_fx_codes.join(", ") %></strong> — without them, conversion defaults to 1:1 and totals can be misleading.
        </p>
      <% end %>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <% @overall_stats.each do |k, v| %>
          <div>
            <p class="text-xs uppercase tracking-wide text-slate-500"><%= k.to_s.humanize %></p>
            <p class="mt-1 text-lg font-semibold"><%= format_stat_card_value(k, v, precision: 2) %></p>
          </div>
        <% end %>
        <div>
          <p class="text-xs uppercase tracking-wide text-slate-500">Overall XIRR (excl. emergency)</p>
          <% if @overall_xirr&.annualized_percent %>
            <p class="mt-1 text-lg font-semibold tabular-nums"><%= number_with_precision(@overall_xirr.annualized_percent, precision: 2) %>%</p>
          <% else %>
            <p class="mt-1 text-lg font-semibold text-slate-400">—</p>
          <% end %>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-slate-500">Overall XIRR (incl. emergency)</p>
          <% if @overall_xirr_with_emergency&.annualized_percent %>
            <p class="mt-1 text-lg font-semibold tabular-nums"><%= number_with_precision(@overall_xirr_with_emergency.annualized_percent, precision: 2) %>%</p>
          <% else %>
            <p class="mt-1 text-lg font-semibold text-slate-400">—</p>
          <% end %>
        </div>
      </div>
      <p class="mt-3 text-xs text-slate-500">Per-asset values use that asset’s currency (latest price in that currency), then convert for aggregation. <%= link_to "Browse portfolios", portfolios_path, class: "text-blue-600 underline" %> or <%= link_to "all portfolios statistics", statistics_portfolios_path, class: "text-blue-600 underline" %> (targets and allocation). List % combined includes wallet cash in the denominator.</p>
    </div>
  <% end %>

  <% if @wallet_cash_reporting.to_d.nonzero? || @free_cash_metrics[:target_pct].present? %>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-4 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="font-medium text-slate-900">Free cash (all wallets)</h2>
        <%= link_to "Edit target", edit_settings_free_cash_target_path, class: "rounded-md border border-emerald-300 bg-white px-3 py-1.5 text-sm text-emerald-900 hover:bg-emerald-50" %>
      </div>
      <div class="mt-3">
        <%= render "portfolios/free_cash_target_readout", metrics: @free_cash_metrics, reporting_currency: @reporting_currency %>
      </div>
    </div>
  <% end %>

  <% if @portfolio.blank? %>
    <p class="text-slate-600">Create a <%= link_to "portfolio", new_portfolio_path, class: "text-blue-600 underline" %> and add holdings to see KPIs and charts.</p>
  <% else %>
    <h2 class="text-lg font-medium text-slate-900">Selected: <%= @portfolio.name %></h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <% @stats.each do |k, v| %>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-xs uppercase tracking-wide text-slate-500"><%= k.to_s.humanize %></p>
          <p class="mt-1 text-lg font-semibold"><%= format_stat_card_value(k, v, precision: 2) rescue v %></p>
        </div>
      <% end %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-slate-500">XIRR (annualized)</p>
        <% if @portfolio_xirr&.annualized_percent %>
          <p class="mt-1 text-lg font-semibold tabular-nums"><%= number_with_precision(@portfolio_xirr.annualized_percent, precision: 2) %>%</p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500">—</p>
        <% end %>
        <p class="mt-2 text-xs text-slate-500">Buys, sells, dividends + NAV. <%= link_to "Details", xirr_portfolio_path(@portfolio), class: "text-blue-600 underline" %></p>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
           data-controller="line-chart"
           data-line-chart-url-value="<%= api_portfolio_performance_path(@portfolio.id, range: '1m') %>">
        <h2 class="mb-2 font-medium text-slate-900">Performance</h2>
        <div class="flex flex-wrap gap-2 text-xs">
          <% %w[1w 1m ytd 1y].each do |r| %>
            <button
              type="button"
              class="rounded px-2 py-1 bg-slate-100 text-slate-700 hover:bg-slate-200"
              data-line-chart-target="rangeButton"
              data-action="line-chart#setRange"
              data-range="<%= r %>"
              aria-pressed="false"
            ><%= r.upcase %></button>
          <% end %>
        </div>
        <div class="mt-3 min-h-[2.75rem]" data-line-chart-target="summary"></div>
        <canvas class="mt-4 max-h-64" data-line-chart-target="canvas"></canvas>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
           data-controller="donut-chart"
           data-donut-chart-url-value="<%= api_portfolio_allocation_path(@portfolio.id) %>">
        <h2 class="mb-2 font-medium text-slate-900">Allocation</h2>
        <canvas class="mt-4 max-h-64" data-donut-chart-target="canvas"></canvas>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-3 font-medium text-slate-900">Category targets</div>
      <table data-controller="sortable-table" class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">Category</th>
            <th class="px-4 py-2">Value</th>
            <th class="px-4 py-2">Actual %</th>
            <th class="px-4 py-2">Target %</th>
            <th class="px-4 py-2">Deviation</th>
          </tr>
        </thead>
        <tbody>
          <% @allocation.each do |row| %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-2"><%= row[:category] %></td>
              <td class="px-4 py-2"><%= number_with_precision(row[:value], precision: 2) %></td>
              <td class="px-4 py-2"><%= number_with_precision(row[:actual_pct], precision: 2) %>%</td>
              <td class="px-4 py-2"><%= row[:target_pct] ? "#{number_with_precision(row[:target_pct], precision: 2)}%" : "—" %></td>
              <td class="px-4 py-2">
                <% if row[:deviation] %>
                  <% d = row[:deviation].to_f %>
                  <span class="<%= d.abs <= 1 ? 'text-blue-600 font-medium tabular-nums' : pnl_class_for(row[:deviation]) %>">
                    <%= number_with_precision(row[:deviation], precision: 2) %>%
                  </span>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3 font-medium text-slate-900">Recent transactions</div>
    <ul class="divide-y divide-slate-100 text-sm">
      <% @recent.each do |t| %>
        <li class="flex flex-wrap gap-2 px-4 py-2">
          <span class="text-slate-500"><%= l t.date.to_date %></span>
          <% if t.portfolio %>
            <span class="text-slate-500"><%= t.portfolio.name %> ·</span>
          <% end %>
          <span class="font-medium"><%= t.transaction_type.label %></span>
          <span><%= link_to t.asset.code, t.asset, class: "text-blue-600 hover:underline" %></span>
          <span class="ml-auto"><%= number_with_precision(t.total_amount, precision: 2) %> <%= t.currency.code %></span>
        </li>
      <% end %>
    </ul>
  </div>
</div>
