<% content_for :title, params[:table] %>
<div class="flex justify-between">
  <h1 class="text-2xl font-semibold"><%= params[:table].humanize %></h1>
  <%= link_to "Add row", settings_new_lookup_row_path(params[:table]), class: "rounded-md bg-blue-600 px-4 py-2 text-sm text-white" %>
</div>
<table data-controller="sortable-table" class="mt-6 w-full text-left text-sm">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-2">Key</th><th>Label</th><th>Pos</th><th>Active</th><th></th></tr></thead>
  <tbody>
    <% @records.each do |r| %>
      <tr class="border-t border-slate-100">
        <td class="px-3 py-2 font-mono"><%= r.key %></td>
        <td><%= r.label %></td>
        <td><%= r.position %></td>
        <td><%= r.active %></td>
        <td class="flex gap-2">
          <%= link_to "Edit", settings_edit_lookup_row_path(params[:table], r), class: "text-blue-600" %>
          <%= button_to "Delete", settings_destroy_lookup_row_path(params[:table], r), method: :delete, class: "text-red-600 text-xs" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<p class="mt-4"><%= link_to "← Back", settings_lookups_path, class: "text-sm text-blue-600" %></p>
