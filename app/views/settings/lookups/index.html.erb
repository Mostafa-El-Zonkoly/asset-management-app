<% content_for :title, "Lookup tables" %>
<h1 class="text-2xl font-semibold">Lookup tables</h1>

<div class="mt-8 max-w-xl rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <h2 class="text-sm font-semibold text-slate-900">Distribution</h2>
  <p class="mt-1 text-xs text-slate-600">Pick a lookup dimension to open a sortable distribution table in a new tab. Only assets with current holdings are included.</p>
  <div class="mt-3">
    <label for="dist-picker" class="sr-only">Lookup type</label>
    <select id="dist-picker"
            class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
            onchange="if(this.value) window.open('<%= settings_lookups_path %>' + '/' + this.value + '/distribution', '_blank'); this.value='';">
      <option value="">— Select lookup type —</option>
      <% LookupAssetDistributionService.distributable_tables.each do |k| %>
        <option value="<%= k %>"><%= k.humanize %></option>
      <% end %>
    </select>
  </div>
</div>

<ul class="mt-6 grid gap-2 sm:grid-cols-2">
  <% @tables.each do |t| %>
    <li><%= link_to t.humanize, settings_lookup_table_path(t), class: "block rounded-lg border border-slate-200 bg-white px-4 py-3 hover:bg-slate-50" %></li>
  <% end %>
</ul>
