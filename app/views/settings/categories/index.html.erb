<% content_for :title, "Categories" %>
<div class="flex justify-between">
  <h1 class="text-2xl font-semibold">Categories</h1>
  <%= link_to "New category", new_settings_category_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm text-white" %>
</div>
<ul class="mt-6 space-y-2">
  <% @categories.each do |c| %>
    <li class="flex justify-between rounded-lg border border-slate-200 bg-white px-4 py-3">
      <div><span class="font-medium"><%= c.name %></span> <span class="text-sm text-slate-500"><%= c.category_type.label %></span></div>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_settings_category_path(c), class: "text-sm" %>
        <%= button_to "Delete", settings_category_path(c), method: :delete, class: "text-sm text-red-600" %>
      </div>
    </li>
  <% end %>
</ul>
