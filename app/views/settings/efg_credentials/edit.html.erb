<% content_for :title, "EFG API credentials" %>
<div class="mx-auto max-w-xl space-y-6">
  <div>
    <h1 class="text-2xl font-semibold">EFG API credentials</h1>
    <p class="mt-1 text-sm text-slate-600">
      Used to fetch EGX stock prices from EFG Hermes (falls back to Mubasher if EFG fails).
      Credentials are stored encrypted and are <strong>write-only</strong>: they can be replaced or removed, but never displayed.
    </p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 text-sm shadow-sm">
    <% if @credential %>
      <p><span class="font-medium text-green-700">Configured</span> · company code <%= @credential.company_code %></p>
      <p class="mt-1 text-slate-600">Last updated <%= l(@credential.updated_at, format: :long) %><%= " by #{@credential.updated_by_email}" if @credential.updated_by_email.present? %></p>
      <p class="mt-1 text-slate-600">
        Last successful test: <%= @credential.last_verified_at ? l(@credential.last_verified_at, format: :long) : "never" %>
      </p>
      <div class="mt-3 flex gap-2">
        <%= button_to "Test connection", test_settings_efg_credential_path, method: :post,
              class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50" %>
        <%= button_to "Remove", settings_efg_credential_path, method: :delete,
              form: { data: { turbo_confirm: "Remove the EFG credentials? Prices will fall back to Mubasher." } },
              class: "rounded-md border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50" %>
      </div>
    <% else %>
      <p class="text-slate-600">Not configured. Stock prices are fetched from Mubasher.</p>
    <% end %>
  </div>

  <%= form_with scope: :efg_credential, url: settings_efg_credential_path, method: :patch,
        html: { autocomplete: "off" }, class: "space-y-4" do |f| %>
    <h2 class="font-medium text-slate-900"><%= @credential ? "Replace credentials" : "Set credentials" %></h2>
    <div>
      <%= f.label :trading_id, "Trading ID", class: "block text-sm font-medium text-slate-900" %>
      <%= f.password_field :trading_id, value: nil, required: true, autocomplete: "off",
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :api_key, "API key", class: "block text-sm font-medium text-slate-900" %>
      <%= f.password_field :api_key, value: nil, required: true, autocomplete: "new-password",
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :company_code, "Company code", class: "block text-sm font-medium text-slate-900" %>
      <%= f.select :company_code, EfgCredential::COMPANY_CODES, { selected: @credential&.company_code || "003" },
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <%= f.submit "Save", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
  <% end %>
</div>
