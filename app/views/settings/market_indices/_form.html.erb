<%= form_with model: [:settings, market_index], class: "max-w-lg space-y-4" do |f| %>
  <% if market_index.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-800"><%= market_index.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-900" %>
    <%= f.text_field :name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :code, class: "block text-sm font-medium text-slate-900" %>
    <%= f.text_field :code, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-900" %>
    <%= f.text_area :description, rows: 2, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :currency_id, "Currency", class: "block text-sm font-medium text-slate-900" %>
    <%= f.collection_select :currency_id, @currencies, :id, :code, {}, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <%= f.submit class: "rounded-md bg-blue-600 px-4 py-2 text-sm text-white" %>
<% end %>
