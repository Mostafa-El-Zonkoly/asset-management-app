<%= form_with model: payment, class: "max-w-md space-y-4" do |f| %>
  <% if payment.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-800"><%= payment.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <%= f.label :paid_on, class: "block text-sm font-medium text-slate-900" %>
    <%= f.date_field :paid_on, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :amount, class: "block text-sm font-medium text-slate-900" %>
    <%= f.number_field :amount, step: :any, min: 0, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :currency_id, "Currency", class: "block text-sm font-medium text-slate-900" %>
    <%= f.collection_select :currency_id, currencies, :id, :code, {}, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-slate-900" %>
    <%= f.text_area :notes, rows: 3, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
    <%= link_to "Cancel", zaka_payments_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm" %>
  </div>
<% end %>
