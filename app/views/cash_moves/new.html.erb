<% content_for :title, "Transfer cash" %>
<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Transfer cash</h1>
    <%= link_to "Recent moves", cash_moves_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>
  <p class="mt-1 text-sm text-slate-500">Wallet → Portfolio is a <strong>contribution</strong>; Portfolio → Wallet is a <strong>withdrawal</strong>; Portfolio → Portfolio is an <strong>internal transfer</strong> (both legs created automatically). Buys and sells are not cash moves.</p>

  <% if flash.now[:alert] %>
    <div class="mt-3 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700"><%= flash.now[:alert] %></div>
  <% end %>

  <% options = @wallets.map { |w| ["Wallet · #{w.code}", "wallet:#{w.id}"] } + @portfolios.map { |p| ["Portfolio · #{p.name}", "portfolio:#{p.id}"] } %>
  <%= form_with url: cash_moves_path, method: :post, class: "mt-4 space-y-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm" do %>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-sm">
        <span class="font-medium text-slate-700">From</span>
        <%= select_tag :from, options_for_select(options), class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
      </label>
      <label class="block text-sm">
        <span class="font-medium text-slate-700">To</span>
        <%= select_tag :to, options_for_select(options), class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
      </label>
      <label class="block text-sm">
        <span class="font-medium text-slate-700">Amount</span>
        <%= number_field_tag :amount, nil, step: "any", min: 0, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
      </label>
      <label class="block text-sm">
        <span class="font-medium text-slate-700">Currency</span>
        <%= collection_select :none, :currency_id, @currencies, :id, :code, {}, name: "currency_id", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
      </label>
      <label class="block text-sm">
        <span class="font-medium text-slate-700">Date / time</span>
        <%= datetime_field_tag :occurred_at, Time.current.strftime("%Y-%m-%dT%H:%M"), class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
      </label>
    </div>
    <label class="block text-sm">
      <span class="font-medium text-slate-700">Notes</span>
      <%= text_area_tag :notes, nil, rows: 2, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
    </label>
    <div class="flex items-center gap-2">
      <%= submit_tag "Record cash move", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
      <%= link_to "Cancel", portfolios_path, class: "text-sm text-slate-600 hover:underline" %>
    </div>
  <% end %>
</div>
