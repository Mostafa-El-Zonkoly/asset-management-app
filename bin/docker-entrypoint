#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

# Create the database, load the schema, run pending migrations, and seed on
# first boot. Idempotent and safe to re-run on every deploy.
# Set SKIP_DB_PREPARE=1 to bypass (e.g. for a one-off console/rake container).
if [ "${SKIP_DB_PREPARE}" != "1" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
